import { NextResponse } from 'next/server';

import { requireAdmin } from '@/lib/server-auth';
import { adminDb } from '@/lib/firebase-admin';
import { generateGroqResponse } from '@/lib/server-groq';

type ScreeningLabel =
  | 'AI_APPROVED'
  | 'LOOKS_GOOD'
  | 'NEEDS_REVIEW'
  | 'LOOKS_BUG'
  | 'LOOKS_SPAM'
  | 'HIGH_RISK';

interface ScreeningResult {
  label: ScreeningLabel;
  score: number;
  summary: string;
  reasons: string[];
  positiveSignals: string[];
  riskSignals: string[];
  missingInformation: string[];
  contradictions: string[];
  recommendation:
    | 'AUTO_ONBOARD'
    | 'MANUAL_REVIEW'
    | 'DO_NOT_AUTO_APPROVE';
  autoEligible: boolean;
}

function text(value: unknown): string {
  return typeof value === 'string'
    ? value.trim()
    : '';
}

function safeArray(
  value: unknown
): string[] {
  if (!Array.isArray(value)) {
    return [];
  }

  return value
    .filter(
      (item): item is string =>
        typeof item === 'string'
    )
    .map((item) =>
      item.trim()
    )
    .filter(Boolean)
    .slice(0, 20);
}

function parseJson(
  value: string
): ScreeningResult | null {
  const cleaned =
    value
      .replace(/^```json/i, '')
      .replace(/^```/i, '')
      .replace(/```$/i, '')
      .trim();

  try {
    return JSON.parse(
      cleaned
    ) as ScreeningResult;
  } catch {
    return null;
  }
}

function normalizeScore(
  score: unknown
): number {
  const value =
    Number(score);

  if (!Number.isFinite(value)) {
    return 0;
  }

  return Math.max(
    0,
    Math.min(
      100,
      Math.round(value)
    )
  );
}

function enforceClassification(
  result: ScreeningResult
): ScreeningResult {
  const score =
    normalizeScore(
      result.score
    );

  const reasons =
    safeArray(
      result.reasons
    );

  const positiveSignals =
    safeArray(
      result.positiveSignals
    );

  const riskSignals =
    safeArray(
      result.riskSignals
    );

  const missingInformation =
    safeArray(
      result.missingInformation
    );

  const contradictions =
    safeArray(
      result.contradictions
    );

  /*
   * Automatic onboarding is deliberately conservative.
   *
   * 97+:
   * - complete application
   * - no material contradictions
   * - no strong spam/risk signals
   *
   * AI is still not claiming legal identity verification.
   */
  const severeRisk =
    riskSignals.some(
      (item) =>
        /fraud|phishing|fake|stolen|malicious|scam|impersonat/i.test(
          item
        )
    ) ||
    contradictions.length >= 3;

  let label: ScreeningLabel;

  if (
    severeRisk &&
    score < 97
  ) {
    label = 'HIGH_RISK';
  } else if (
    missingInformation.length >= 3
  ) {
    label = 'LOOKS_BUG';
  } else if (
    score >= 97 &&
    !severeRisk &&
    riskSignals.length === 0
  ) {
    label = 'AI_APPROVED';
  } else if (
    score >= 88 &&
    riskSignals.length <= 1
  ) {
    label = 'LOOKS_GOOD';
  } else if (
    score < 45
  ) {
    label = 'LOOKS_SPAM';
  } else {
    label = 'NEEDS_REVIEW';
  }

  const autoEligible =
    label ===
      'AI_APPROVED' &&
    score >= 97 &&
    riskSignals.length === 0 &&
    contradictions.length === 0 &&
    missingInformation.length === 0;

  return {
    label,

    score,

    summary:
      text(result.summary) ||
      'AI screening completed.',

    reasons,

    positiveSignals,

    riskSignals,

    missingInformation,

    contradictions,

    recommendation:
      autoEligible
        ? 'AUTO_ONBOARD'
        : label === 'LOOKS_SPAM' ||
            label === 'HIGH_RISK'
          ? 'DO_NOT_AUTO_APPROVE'
          : 'MANUAL_REVIEW',

    autoEligible,
  };
}

export async function POST(
  request: Request
) {
  try {
    await requireAdmin(request);

    const body =
      await request.json();

    const applicationId =
      text(
        body.applicationId ||
          body.id
      );

    if (!applicationId) {
      return NextResponse.json(
        {
          error:
            'Seller application ID is required.',
        },
        {
          status: 400,
        }
      );
    }

    const applicationRef =
      adminDb.ref(
        `sellerApplications/${applicationId}`
      );

    const snapshot =
      await applicationRef.get();

    if (!snapshot.exists()) {
      return NextResponse.json(
        {
          error:
            'Seller application was not found.',
        },
        {
          status: 404,
        }
      );
    }

    const application =
      snapshot.val();

    const applicationText =
      JSON.stringify(
        application,
        null,
        2
      );

    const systemPrompt = `
You are Auronix Commerce LLC's internal seller-application screening AI.

Your task is to assess whether a submitted seller application appears:
- complete and internally consistent
- commercially plausible
- relevant to Auronix
- likely to be a genuine business inquiry
- suspicious, spam-like, contradictory, or malformed

IMPORTANT:
- You are NOT performing legal identity verification.
- You cannot prove that a business exists merely from an application.
- Do not claim that a person or company is officially verified.
- Never infer sensitive personal characteristics.
- Focus only on business/application quality and obvious spam or abuse signals.
- Do not reject an application solely because a small business has limited web presence.
- Do not penalize applicants for using free email services by themselves.
- A missing website alone is not proof of spam.
- Generic or imperfect wording is not automatically suspicious.
- Look for multiple signals together.
- Do not invent facts that are not present in the application.
- Be conservative when deciding whether automatic onboarding is appropriate.

Strong positive signals can include:
- complete contact information
- coherent company/business description
- realistic products or services
- clear reason for wanting to work with Auronix
- consistent company/name/contact information
- sensible catalog/product information
- professional communication
- information that logically matches other submitted fields

Potential risk signals can include:
- obvious copied/generated spam patterns
- contradictory company information
- impossible or nonsensical business claims
- malicious URLs
- requests for credentials or payment information
- obviously fake placeholder data
- repeated promotional spam
- suspicious impersonation
- incompatible information between fields

Return ONLY valid JSON.

Schema:

{
  "label": "AI_APPROVED | LOOKS_GOOD | NEEDS_REVIEW | LOOKS_BUG | LOOKS_SPAM | HIGH_RISK",
  "score": 0,
  "summary": "short explanation",
  "reasons": [],
  "positiveSignals": [],
  "riskSignals": [],
  "missingInformation": [],
  "contradictions": [],
  "recommendation": "AUTO_ONBOARD | MANUAL_REVIEW | DO_NOT_AUTO_APPROVE",
  "autoEligible": false
}

Score guidance:
97-100 = exceptionally complete and consistent; eligible for AI-cleared onboarding
88-96 = looks good; manual review recommended
65-87 = needs review
45-64 = possible application-quality problem
0-44 = likely spam or highly suspicious

Never give 97+ merely because the application looks professional.
`;

    const userPrompt = `
Review this seller application:

${applicationText}

Return the JSON screening result only.
`;

    const raw =
      await generateGroqResponse(
        systemPrompt,
        userPrompt,
        1400
      );

    const parsed =
      parseJson(raw);

    if (!parsed) {
      throw new Error(
        'AI returned an invalid screening result.'
      );
    }

    const result =
      enforceClassification(
        parsed
      );

    const now =
      Date.now();

    await applicationRef.update({
      aiScreening: {
        ...result,

        screenedAt:
          now,

        model:
          process.env.GROQ_MODEL ||
          'configured-ai-model',

        version:
          'seller-screen-v1',
      },

      aiStatus:
        result.label,

      aiScore:
        result.score,

      aiAutoEligible:
        result.autoEligible,

      updatedAt:
        now,
    });

    return NextResponse.json({
      success: true,

      applicationId,

      screening:
        result,
    });
  } catch (error) {
    console.error(
      'Seller AI screening failed:',
      error
    );

    return NextResponse.json(
      {
        error:
          error instanceof Error
            ? error.message
            : 'AI seller screening failed.',
      },
      {
        status: 500,
      }
    );
  }
}
