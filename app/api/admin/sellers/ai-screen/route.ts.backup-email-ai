type Label =
  | 'AI_APPROVED'
  | 'LOOKS_GOOD'
  | 'NEEDS_REVIEW'
  | 'LOOKS_BUG'
  | 'LOOKS_SPAM'
  | 'HIGH_RISK';

type Recommendation =
  | 'AUTO_ONBOARD'
  | 'MANUAL_REVIEW'
  | 'DO_NOT_AUTO_APPROVE';

interface SellerApplication {
  fullName: string;
  businessName: string;
  businessEmail: string;
  phone: string;
  country: string;

  address: string;
  city: string;
  state: string;
  zipCode: string;

  website: string;
  businessType: string;
  yearsInBusiness: string;
  productCategories: string;

  businessInformation: string;
  whyWorkWithAuronix: string;

  catalogUrl: string;
  contactAgreement: boolean;
