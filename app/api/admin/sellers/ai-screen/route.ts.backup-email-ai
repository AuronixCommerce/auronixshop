function getInvitationUrl(
  applicationId: string
): string {
  const base =
    process.env.NEXT_PUBLIC_SITE_URL ||
    process.env.AURONIX_WEBSITE ||
    'https://auronixcommerce.com';

  return `${base.replace(
    /\/$/,
    ''
  )}/seller/activate?applicationId=${encodeURIComponent(
    applicationId
  )}`;
}

async function autoApproveAndInvite(
  applicationId: string,
  app: SellerApplication,
  firstPass: AIResult,
  secondPass: VerificationResult,
  quality: number
) {
  const applicationRef =
    adminDb.ref(
      `sellerApplications/${applicationId}`
    );

  const current =
    await applicationRef.get();

  if (!current.exists()) {
    throw new Error(
      'Application disappeared before approval.'
    );
  }

  const existing =
    current.val() as Record<
      string,
      unknown
    >;

  /*
   * Idempotency:
   * never send the same invitation twice.
   */
  if (
    existing.invitationSentAt
  ) {
    return {
      approved: true,
      invitationSent: false,
      alreadySent: true,
    };
  }

  const invitationUrl =
    getInvitationUrl(
      applicationId
    );

  /*
   * Re-check the record immediately before approval.
   */
  const latest =
    await applicationRef.get();

  const latestData =
    latest.val() as Record<
      string,
      unknown
    >;

  if (
    latestData.status ===
      'approved' ||
    latestData.accountCreated ===
      true
  ) {
    return {
      approved: true,
      invitationSent: false,
      alreadyApproved: true,
    };
  }

  await applicationRef.update({
    status:
      'approved',

    approvedBy:
      'ai-auto-approval',

    approvedAt:
      Date.now(),

    accountCreated:
      false,

    aiAutoApproved:
      true,

    aiAutoApprovedAt:
      Date.now(),

    aiDecision: {
      firstPass,
      secondPass,

      deterministicQuality:
        quality,

      verifiedAt:
        Date.now(),

      verificationVersion:
        'seller-auto-v1',
    },

    invitationUrl,

    updatedAt:
      Date.now(),
  });

  try {
    /*
     * Your current mail helper uses a single argument.
     *
     * We send a single object containing the complete
     * invitation context.
     */
    await sendSellerInvitationEmail({
      email:
        app.businessEmail,

      name:
        app.fullName,

      businessName:
        app.businessName,

      invitationUrl,
    });

    await applicationRef.update({
      invitationSentAt:
        Date.now(),

      invitationSentBy:
        'ai-auto-approval',

      accountCreationStatus:
        'invitation_sent',

      updatedAt:
        Date.now(),
    });

    return {
      approved: true,
      invitationSent: true,
    };
  } catch (emailError) {
    /*
     * Approval remains recorded, but invitation failure
     * is explicitly tracked so it can be retried safely.
     */
    await applicationRef.update({
      accountCreationStatus:
        'invitation_failed',

      invitationError:
        emailError instanceof Error
          ? emailError.message
          : 'Invitation email failed.',

      updatedAt:
        Date.now(),
    });

    throw emailError;
  }
}

async function screenApplication(
  applicationId: string,
  automaticMode: boolean
) {
  const applicationRef =
    adminDb.ref(
      `sellerApplications/${applicationId}`
    );

  const snapshot =
    await applicationRef.get();

  if (!snapshot.exists()) {
    throw new Error(
      'Seller application was not found.'
    );
  }

  const raw =
    snapshot.val() as Record<
      string,
      unknown
    >;

  const app =
    normalizeApplication(
      raw
    );

  const checks =
    deterministicChecks(
      app
    );

  const firstPass =
    await askScreeningAI(
      app
    );

  const strongFirstPass =
    (
      firstPass.label ===
        'AI_APPROVED' ||
      (
        firstPass.confidence >= 95 &&
        firstPass.riskSignals.length === 0 &&
        firstPass.contradictions.length === 0
      )
    );

  /*
   * Second verification only happens for the strong path.
   */
  let secondPass:
    | VerificationResult
    | null =
    null;

  if (
    strongFirstPass &&
    checks.complete &&
    checks.riskSignals.length === 0
  ) {
    secondPass =
      await askVerificationAI(
        app,
        firstPass,
        checks
      );
  }

  const combinedRisks =
    unique([
      ...checks.riskSignals,
      ...firstPass.riskSignals,
      ...(secondPass?.riskSignals ||
        []),
    ]);

  const combinedContradictions =
    unique([
      ...firstPass.contradictions,
      ...(secondPass?.contradictions ||
        []),
    ]);

  const firstConfidence =
    Math.round(
      firstPass.confidence
    );

  const secondConfidence =
    secondPass
      ? Math.round(
          secondPass.confidence
        )
      : 0;

  /*
   * FINAL AUTO-APPROVAL GATE.
   *
   * This is intentionally much stricter than simply
   * trusting "AI Approved".
   */
  const autoEligible =
    automaticMode &&
    checks.complete &&
    checks.meaningfulBusinessInfo &&
    checks.meaningfulMotivation &&
    checks.meaningfulProducts &&
    checks.riskSignals.length === 0 &&
    combinedRisks.length === 0 &&
    combinedContradictions.length === 0 &&
    strongFirstPass &&
    secondPass?.approved === true &&
    secondConfidence >= 95 &&
    firstConfidence >= 95 &&
    checks.quality >= 90;

  let label: Label;
  let recommendation:
    Recommendation;

  let confidence =
    Math.min(
      firstConfidence,
      secondPass
        ? secondConfidence
        : firstConfidence
    );

  if (
    combinedRisks.length > 0
  ) {
    const obviousSpam =
      combinedRisks.some(
        (risk) =>
          /spam|scam|malicious|credential|payment|phishing|fraud/i.test(
            risk
          )
      );

    label =
      obviousSpam
        ? 'HIGH_RISK'
        : 'LOOKS_SPAM';

    recommendation =
      'DO_NOT_AUTO_APPROVE';

    confidence =
      Math.max(
        90,
        confidence
      );
  } else if (
    checks.missing.length > 0
  ) {
    label =
      checks.missing.length >= 4
        ? 'LOOKS_BUG'
        : 'NEEDS_REVIEW';

    recommendation =
      'MANUAL_REVIEW';

    confidence =
      Math.max(
        80,
        confidence
      );
  } else if (
    autoEligible
  ) {
    label =
      'AI_APPROVED';

    recommendation =
      'AUTO_ONBOARD';

    confidence =
      100;
  } else if (
    confidence >= 85
  ) {
    label =
      'LOOKS_GOOD';

    recommendation =
      'MANUAL_REVIEW';
  } else {
    label =
      'NEEDS_REVIEW';

    recommendation =
      'MANUAL_REVIEW';
  }

  const reasons =
    unique([
      ...checks.issues,

      ...firstPass.reasons,

      ...(secondPass?.reasons ||
        []),

      `Deterministic quality score: ${checks.quality}/100.`,

      secondPass
        ? `Independent second AI verification confidence: ${secondConfidence}%.`
        : 'Second AI verification was not triggered because the first-stage criteria were not met.',
    ]);

  if (
    autoEligible
  ) {
    reasons.push(
      'First AI screening passed.'
    );

    reasons.push(
      'Independent second AI verification passed.'
    );

    reasons.push(
      'All required application fields are complete.'
    );

    reasons.push(
      'No material risk signals were detected.'
    );

    reasons.push(
      'No material contradictions were detected.'
    );

    reasons.push(
      'Application quality passed the automatic onboarding threshold.'
    );
  }

  const positiveSignals =
    unique([
      ...firstPass.positiveSignals,
    ]);

  const missingInformation =
    unique([
      ...checks.missing,
      ...firstPass.missingInformation,
    ]);

  const summary =
    autoEligible
      ? 'The application passed two-stage AI screening and deterministic validation. It is eligible for automatic seller onboarding.'
      : label === 'HIGH_RISK'
        ? 'Strong risk or spam indicators were detected. Automatic onboarding is blocked.'
        : label === 'LOOKS_BUG'
          ? 'The application is incomplete and requires correction or manual review.'
          : label === 'NEEDS_REVIEW'
            ? 'The application requires manual review before approval.'
            : 'The application looks generally good but did not pass every automatic-onboarding condition.';

  const result = {
    label,

    confidence,

    summary,

    reasons,

    positiveSignals,

    riskSignals:
      combinedRisks,

    missingInformation,

    contradictions:
      combinedContradictions,

    recommendation,

    autoEligible,

    firstPass: {
      label:
        firstPass.label,

      confidence:
        firstConfidence,
    },

    secondPass: secondPass
      ? {
          approved:
            secondPass.approved,

          confidence:
            secondConfidence,
        }
      : null,

    deterministicQuality:
      checks.quality,

    verificationRoutes: [
      'deterministic-validation',
      'first-ai-review',
      ...(secondPass
        ? ['independent-second-ai-review']
        : []),
    ],
  };

  const now =
    Date.now();

  await applicationRef.update({
    aiStatus:
      label,

    aiScore:
      confidence,

    aiAutoEligible:
      autoEligible,

    aiScreening: {
      ...result,

      screenedAt:
        now,

      version:
        'seller-screen-v5',
    },

    updatedAt:
      now,
  });

  let autoApproval:
    | Record<string, unknown>
    | null =
    null;

  if (
    autoEligible
  ) {
    try {
      autoApproval =
        await autoApproveAndInvite(
          applicationId,
          app,
          firstPass,
          secondPass!,
          checks.quality
        );
    } catch (error) {
      autoApproval = {
        approved:
          false,

        invitationSent:
          false,

        error:
          error instanceof Error
            ? error.message
            : 'Automatic seller onboarding failed.',
      };
    }
  }

  return {
    applicationId,

    screening:
      result,

    autoApproval,
  };
}

export async function POST(
  request: Request
) {
  try {
    await requireAdmin(
      request
    );

    const body =
      await request.json();

    const applicationId =
      text(
        body.applicationId
      );

    if (
      applicationId
    ) {
      return NextResponse.json({
        success: true,

        ...(await screenApplication(
          applicationId,
          body.automatic === true
        )),
      });
    }

    if (
      body.screenAll === true
    ) {
      const snapshot =
        await adminDb
          .ref(
            'sellerApplications'
          )
          .get();

      if (
        !snapshot.exists()
      ) {
        return NextResponse.json({
          success: true,
          screened: 0,
          results: [],
        });
      }

      const applications =
        snapshot.val() as Record<
          string,
          Record<string, unknown>
        >;

      const results: unknown[] =
        [];

      for (
        const [
          id,
          application,
        ] of Object.entries(
          applications
        )
      ) {
        const status =
          text(
            application.status
          ).toLowerCase();

        if (
          status === 'approved' ||
          status === 'rejected'
        ) {
          continue;
        }

        const version =
          text(
            (
              application
                .aiScreening as
                | Record<
                    string,
                    unknown
                  >
                | undefined
            )?.version
          );

        if (
          version ===
          'seller-screen-v5' &&
          application.aiAutoApproved !==
            true
        ) {
          continue;
        }

        try {
          results.push(
            await screenApplication(
              id,
              body.automatic === true
            )
          );
        } catch (error) {
          results.push({
            applicationId:
              id,

            error:
              error instanceof Error
                ? error.message
                : 'Screening failed.',
          });
        }
      }

      return NextResponse.json({
        success: true,

        screened:
          results.filter(
            (item: any) =>
              !item.error
          ).length,

        results,
      });
    }

    return NextResponse.json(
      {
        error:
          'Provide applicationId or screenAll=true.',
      },
      {
        status: 400,
      }
    );
  } catch (error) {
    console.error(
      'Seller AI screening failed:',
      error
    );

    return NextResponse.json(
      {
        error:
          error instanceof Error
            ? error.message
            : 'Seller AI screening failed.',
      },
      {
        status: 500,
      }
    );
  }
}
