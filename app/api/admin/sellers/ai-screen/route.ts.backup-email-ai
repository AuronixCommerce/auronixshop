function missingRequiredFields(
  app: SellerApplication
): string[] {
  const missing: string[] = [];

  const required: Array<
    [keyof SellerApplication, string]
  > = [
    ['fullName', 'Full Name'],
    ['businessName', 'Business Name'],
    ['businessEmail', 'Business Email'],
    ['phone', 'Phone'],
    ['country', 'Country'],
    ['address', 'Address'],
    ['city', 'City'],
    ['state', 'State / Province'],
    ['zipCode', 'ZIP / Postal Code'],
    ['businessType', 'Business Type'],
    ['productCategories', 'Product Categories'],
    [
      'businessInformation',
      'Business Information',
    ],
    [
      'whyWorkWithAuronix',
      'Why Work With Auronix',
    ],
  ];

  for (
    const [key, label] of required
  ) {
    if (
      !String(
        app[key] ?? ''
      ).trim()
    ) {
      missing.push(label);
    }
  }

  if (
    !app.contactAgreement
  ) {
    missing.push(
      'Contact Agreement'
    );
  }

  return missing;
}

function deterministicChecks(
  app: SellerApplication
) {
  const missing =
    missingRequiredFields(
      app
    );

  const issues: string[] = [];
  const riskSignals: string[] = [];

  const emailMatch =
    app.businessEmail.match(
      /^[^\s@]+@([^\s@]+\.[^\s@]+)$/
    );

  if (!emailMatch) {
    issues.push(
      'Business email format is invalid.'
    );
  }

  const years =
    Number(
      app.yearsInBusiness
    );

  if (
    app.yearsInBusiness &&
    (
      !Number.isFinite(years) ||
      years < 0 ||
      years > 100
    )
  ) {
    issues.push(
      'Years in business is outside the valid range.'
    );
  }

  /*
   * Only obvious malicious/spam indicators are treated
   * as risk. Missing optional information isn't risk.
   */
  const content = [
    app.fullName,
    app.businessName,
    app.productCategories,
    app.businessInformation,
    app.whyWorkWithAuronix,
  ]
    .join(' ')
    .toLowerCase();

  const obviousSpamPatterns = [
    /send (us|me) (your )?password/i,
    /send (us|me) your credentials/i,
    /send (us|me) (your )?otp/i,
    /send payment now/i,
    /send money now/i,
    /guaranteed profits/i,
    /100% guaranteed/i,
    /free money/i,
    /buy now.*buy now/i,
    /winner.*cash/i,
  ];

  for (
    const pattern of obviousSpamPatterns
  ) {
    if (
      pattern.test(
        content
      )
    ) {
      riskSignals.push(
        `Spam/security pattern matched: ${pattern.source}`
      );
    }
  }

  const complete =
    missing.length === 0;

  const meaningfulBusinessInfo =
    app.businessInformation.length >=
    100;

  const meaningfulMotivation =
    app.whyWorkWithAuronix.length >=
    50;

  const meaningfulProducts =
    app.productCategories.length >=
    8;

  /*
   * Base quality is NOT called "confidence".
   * It's an internal completeness/quality score.
   */
  let quality = 0;

  quality += complete
    ? 50
    : Math.round(
        (
          1 -
          missing.length /
            14
        ) *
          50
      );

  if (
    meaningfulBusinessInfo
  ) {
    quality += 15;
  }

  if (
    meaningfulMotivation
  ) {
    quality += 15;
  }

  if (
    meaningfulProducts
  ) {
    quality += 10;
  }

  if (
    app.website
  ) {
    quality += 5;
  }

  if (
    app.catalogUrl
  ) {
    quality += 5;
  }

  if (
    riskSignals.length
  ) {
    quality -= Math.min(
      50,
      riskSignals.length * 15
    );
  }

  quality =
    Math.max(
      0,
      Math.min(
        100,
        Math.round(
          quality
        )
      )
    );

  return {
    missing,
    issues,
    riskSignals,
    complete,
    meaningfulBusinessInfo,
    meaningfulMotivation,
    meaningfulProducts,
    quality,
  };
}

