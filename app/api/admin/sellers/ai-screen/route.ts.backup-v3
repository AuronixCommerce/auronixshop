import { NextResponse } from 'next/server';

import { requireAdmin } from '@/lib/server-auth';
import { adminDb } from '@/lib/firebase-admin';
import { generateGroqResponse } from '@/lib/server-groq';

type ScreeningLabel =
  | 'AI_APPROVED'
  | 'LOOKS_GOOD'
  | 'NEEDS_REVIEW'
  | 'LOOKS_BUG'
  | 'LOOKS_SPAM'
  | 'HIGH_RISK';

type ScreeningRecommendation =
  | 'AUTO_ONBOARD'
  | 'MANUAL_REVIEW'
  | 'DO_NOT_AUTO_APPROVE';

interface ScreeningResult {
  label: ScreeningLabel;
  score: number;
  summary: string;
  reasons: string[];
  positiveSignals: string[];
  riskSignals: string[];
  missingInformation: string[];
  contradictions: string[];
  recommendation: ScreeningRecommendation;
  autoEligible: boolean;
}

function text(value: unknown): string {
  if (
    typeof value === 'string' ||
    typeof value === 'number'
  ) {
    return String(value).trim();
  }

  return '';
}

function firstText(
  object: Record<string, unknown>,
  keys: string[]
): string {
  for (const key of keys) {
    const value =
      text(object[key]);

    if (value) {
      return value;
    }
  }

  return '';
}

function arrayText(
  value: unknown
): string[] {
  if (!Array.isArray(value)) {
    return [];
  }

  return value
    .map(text)
    .filter(Boolean);
}

function unique(
  values: string[]
): string[] {
  return [
    ...new Set(
      values.filter(Boolean)
    ),
  ];
}

function normalizeScore(
  value: unknown
): number {
  const score =
    Number(value);

  if (!Number.isFinite(score)) {
    return 0;
  }

  return Math.max(
    0,
    Math.min(
      100,
      Math.round(score)
    )
  );
}

function getApplicationFacts(
  application: Record<string, unknown>
) {
  const fullName =
    firstText(application, [
      'fullName',
      'name',
      'contactName',
      'applicantName',
    ]);

  const email =
    firstText(application, [
      'email',
      'contactEmail',
      'businessEmail',
    ]);

  const phone =
    firstText(application, [
      'phone',
      'phoneNumber',
      'mobile',
      'contactPhone',
    ]);

  const companyName =
    firstText(application, [
      'companyName',
      'company',
      'businessName',
      'organization',
    ]);

  const website =
    firstText(application, [
      'website',
      'websiteUrl',
      'companyWebsite',
      'businessWebsite',
      'url',
    ]);

  const businessType =
    firstText(application, [
      'businessType',
      'companyType',
      'entityType',
    ]);

  const address =
    firstText(application, [
      'address',
      'businessAddress',
      'streetAddress',
    ]);

  const city =
    firstText(application, [
      'city',
      'businessCity',
    ]);

  const state =
    firstText(application, [
      'state',
      'province',
      'businessState',
    ]);

  const zipCode =
    firstText(application, [
      'zipCode',
      'zip',
      'postalCode',
    ]);

  const country =
    firstText(application, [
      'country',
      'businessCountry',
    ]);

  const categories =
    firstText(application, [
      'productCategories',
      'categories',
      'category',
      'productCategory',
      'productsCategory',
    ]);

  const products =
    firstText(application, [
      'products',
      'productDescription',
      'productDetails',
      'productInfo',
    ]);

  const businessDescription =
    firstText(application, [
      'businessDescription',
      'business_desc',
      'businessDesc',
      'description',
      'companyDescription',
      'aboutBusiness',
      'about',
      'aboutCompany',
    ]);

  const message =
    firstText(application, [
      'message',
      'comments',
      'comment',
      'notes',
      'additionalInformation',
      'additionalInfo',
      'inquiry',
      'reason',
    ]);

  const catalogUrl =
    firstText(application, [
      'catalogUrl',
      'catalog',
      'catalogURL',
      'catalogLink',
      'catalogueUrl',
      'catalogue',
    ]);

  return {
    fullName,
    email,
    phone,
    companyName,
    website,
    businessType,
    address,
    city,
    state,
    zipCode,
    country,
    categories,
    products,
    businessDescription,
    message,
    catalogUrl,
  };
}

function calculateDeterministicScore(
  facts: ReturnType<
    typeof getApplicationFacts
  >,
  ai: ScreeningResult
) {
  const fields = [
    facts.fullName,
    facts.email,
    facts.phone,
    facts.companyName,
    facts.website,
    facts.businessType,
    facts.address,
    facts.city,
    facts.state,
    facts.zipCode,
    facts.country,
    facts.categories,
    facts.products,
    facts.businessDescription,
    facts.message,
  ];

  const completed =
    fields.filter(Boolean).length;

  let score = Math.round(
    (completed /
      fields.length) *
      70
  );

  if (
    facts.website
  ) {
    score += 7;
  }

  if (
    facts.catalogUrl
  ) {
    score += 6;
  }

  if (
    facts.businessDescription.length >=
    120
  ) {
    score += 6;
  }

  if (
    facts.products.length >=
    60
  ) {
    score += 4;
  }

  if (
    facts.message.length >=
    100
  ) {
    score += 4;
  }

  if (
    facts.companyName &&
    facts.email
  ) {
    const companyWords =
      facts.companyName
        .toLowerCase()
        .replace(
          /[^a-z0-9 ]/g,
          ''
        )
        .split(/\s+/)
        .filter(Boolean);

    const emailDomain =
      facts.email
        .split('@')[1]
        ?.toLowerCase() || '';

    const domainMatches =
      companyWords.some(
        (word) =>
          word.length >= 5 &&
          emailDomain.includes(word)
      );

    if (domainMatches) {
      score += 3;
    }
  }

  if (
    ai.riskSignals.length
  ) {
    score -= Math.min(
      20,
      ai.riskSignals.length * 7
    );
  }

  if (
    ai.contradictions.length
  ) {
    score -= Math.min(
      20,
      ai.contradictions.length * 7
    );
  }

  return Math.max(
    0,
    Math.min(
      100,
      score
    )
  );
}

function finalizeScreening(
  facts: ReturnType<
    typeof getApplicationFacts
  >,
  ai: ScreeningResult
): ScreeningResult {
  const deterministicScore =
    calculateDeterministicScore(
      facts,
      ai
    );

  const missingInformation =
    unique([
      ...ai.missingInformation,
    ]);

  const contradictions =
    unique([
      ...ai.contradictions,
    ]);

  const riskSignals =
    unique([
      ...ai.riskSignals,
    ]);

  const reasons =
    unique([
      ...ai.reasons,
    ]);

  const positiveSignals =
    unique([
      ...ai.positiveSignals,
    ]);

  const severeRisk =
    riskSignals.some(
      (item) =>
        /fraud|fake|scam|phishing|malicious|impersonat|stolen|credential/i.test(
          item
        )
    );

  /*
   * An application can receive automatic AI approval only when:
   *
   * - essentially complete
   * - no contradictions
   * - no risk signals
   * - meaningful business description
   * - meaningful product information
   * - meaningful message
   * - contact/business information present
   *
   * The 100 score here is an INTERNAL SCREENING SCORE,
   * not legal identity verification.
   */
  const structurallyComplete =
    Boolean(
      facts.fullName &&
      facts.email &&
      facts.phone &&
      facts.companyName &&
      facts.website &&
      facts.businessType &&
      facts.address &&
      facts.city &&
      facts.state &&
      facts.zipCode &&
      facts.country &&
      facts.categories &&
      facts.products &&
      facts.businessDescription &&
      facts.message
    );

  const strongBusinessContent =
    facts.businessDescription.length >=
      120 &&
    facts.products.length >= 60 &&
    facts.message.length >= 100;

  const automaticEligible =
    structurallyComplete &&
    strongBusinessContent &&
    missingInformation.length === 0 &&
    contradictions.length === 0 &&
    riskSignals.length === 0 &&
    !severeRisk &&
    deterministicScore >= 95;

  let label: ScreeningLabel;
  let score: number;
  let recommendation: ScreeningRecommendation;

  if (
    severeRisk ||
    (
      riskSignals.length >= 2 &&
      deterministicScore < 70
    )
  ) {
    label =
      'HIGH_RISK';

    score =
      Math.min(
        deterministicScore,
        35
      );

    recommendation =
      'DO_NOT_AUTO_APPROVE';
  } else if (
    deterministicScore < 45
  ) {
    label =
      'LOOKS_SPAM';

    score =
      deterministicScore;

    recommendation =
      'DO_NOT_AUTO_APPROVE';
  } else if (
    missingInformation.length >= 3
  ) {
    label =
      'LOOKS_BUG';

    score =
      Math.min(
        deterministicScore,
        70
      );

    recommendation =
      'MANUAL_REVIEW';
  } else if (
    automaticEligible
  ) {
    /*
     * Strong complete application.
     * We intentionally make this deterministic so a model's
     * subjective 92% does not downgrade a clearly complete
     * application.
     */
    label =
      'AI_APPROVED';

    score =
      100;

    recommendation =
      'AUTO_ONBOARD';
  } else if (
    deterministicScore >= 82
  ) {
    label =
      'LOOKS_GOOD';

    score =
      Math.max(
        deterministicScore,
        normalizeScore(ai.score)
      );

    recommendation =
      'MANUAL_REVIEW';
  } else {
    label =
      'NEEDS_REVIEW';

    score =
      deterministicScore;

    recommendation =
      'MANUAL_REVIEW';
  }

  reasons.push(
    `Application completeness score: ${deterministicScore}/100.`
  );

  if (
    automaticEligible
  ) {
    reasons.push(
      'All required business, contact, product, and application narrative fields are present and internally consistent.'
    );

    positiveSignals.push(
      'Complete seller application.'
    );

    positiveSignals.push(
      'Business description contains meaningful operational information.'
    );

    positiveSignals.push(
      'Product information is sufficiently detailed.'
    );

    positiveSignals.push(
      'Applicant message explains the intended relationship with Auronix.'
    );
  }

  return {
    label,
    score,
    summary:
      automaticEligible
        ? 'The application is complete, coherent, commercially relevant, and contains no detected risk signals. It qualifies for the highest-confidence AI screening result.'
        : text(ai.summary) ||
          'AI screening completed.',

    reasons,

    positiveSignals,

    riskSignals,

    missingInformation,

    contradictions,

    recommendation,

    autoEligible:
      automaticEligible,
  };
}

function parseJson(
  value: string
): ScreeningResult | null {
  const cleaned =
    value
      .replace(
        /^```json/i,
        ''
      )
      .replace(
        /^```/i,
        ''
      )
      .replace(
        /```$/i,
        ''
      )
      .trim();

  try {
    return JSON.parse(
      cleaned
    ) as ScreeningResult;
  } catch {
    return null;
  }
}

function normalizeAI(
  result: ScreeningResult
): ScreeningResult {
  return {
    label:
      result.label ||
      'NEEDS_REVIEW',

    score:
      normalizeScore(
        result.score
      ),

    summary:
      text(
        result.summary
      ),

    reasons:
      arrayText(
        result.reasons
      ),

    positiveSignals:
      arrayText(
        result.positiveSignals
      ),

    riskSignals:
      arrayText(
        result.riskSignals
      ),

    missingInformation:
      arrayText(
        result.missingInformation
      ),

    contradictions:
      arrayText(
        result.contradictions
      ),

    recommendation:
      result.recommendation ||
      'MANUAL_REVIEW',

    autoEligible:
      result.autoEligible ===
      true,
  };
}

async function screenOne(
  applicationId: string
) {
  const applicationRef =
    adminDb.ref(
      `sellerApplications/${applicationId}`
    );

  const snapshot =
    await applicationRef.get();

  if (!snapshot.exists()) {
    throw new Error(
      'Seller application was not found.'
    );
  }

  const application =
    snapshot.val() as Record<
      string,
      unknown
    >;

  const facts =
    getApplicationFacts(
      application
    );

  const applicationForAI = {
    id:
      applicationId,

    submittedFields: {
      fullName:
        facts.fullName,

      email:
        facts.email,

      phone:
        facts.phone,

      companyName:
        facts.companyName,

      website:
        facts.website,

      businessType:
        facts.businessType,

      address:
        facts.address,

      city:
        facts.city,

      state:
        facts.state,

      zipCode:
        facts.zipCode,

      country:
        facts.country,

      productCategories:
        facts.categories,

      products:
        facts.products,

      businessDescription:
        facts.businessDescription,

      message:
        facts.message,

      catalogUrl:
        facts.catalogUrl,
    },
  };

  const systemPrompt = `
You are the Auronix Commerce LLC internal seller-application screening AI.

Analyze a seller application for:
1. completeness
2. internal consistency
3. commercial plausibility
4. business relevance
5. spam indicators
6. suspicious or contradictory information

IMPORTANT:
- This is an application-quality screening system.
- It is NOT legal identity verification.
- Do not claim the company is legally verified.
- Do not invent facts.
- Do not treat a free email address as spam by itself.
- Do not treat absence of a website by itself as spam.
- Do not penalize normal grammar mistakes.
- Consider the whole application.
- A strong genuine application should have meaningful business, product, and communication information.
- A blank catalog is acceptable, but a complete application is stronger.
- Give concrete reasons rather than vague statements.

A complete high-quality application should generally contain:
- applicant name
- email
- phone
- company
- website
- business type
- address
- city
- state
- ZIP/postal code
- country
- product categories
- products/product details
- meaningful business description
- meaningful message explaining why they want to work with Auronix

Risk signals should include only meaningful issues such as:
- obvious spam
- malicious URLs
- contradictory business identity information
- repeated promotional nonsense
- impossible claims
- obvious placeholder data
- impersonation indicators
- credential/payment requests

Return ONLY JSON:

{
  "label": "AI_APPROVED | LOOKS_GOOD | NEEDS_REVIEW | LOOKS_BUG | LOOKS_SPAM | HIGH_RISK",
  "score": 0,
  "summary": "short explanation",
  "reasons": [],
  "positiveSignals": [],
  "riskSignals": [],
  "missingInformation": [],
  "contradictions": [],
  "recommendation": "AUTO_ONBOARD | MANUAL_REVIEW | DO_NOT_AUTO_APPROVE",
  "autoEligible": false
}

Do not give an artificially low score simply because you cannot independently verify the company's real-world existence.
`;

  const userPrompt = `
Review this seller application:

${JSON.stringify(
    applicationForAI,
    null,
    2
  )}

Return only the JSON object.
`;

  const raw =
    await generateGroqResponse(
      systemPrompt,
      userPrompt,
      1600
    );

  const parsed =
    parseJson(raw);

  if (!parsed) {
    throw new Error(
      'AI returned invalid JSON.'
    );
  }

  const ai =
    normalizeAI(
      parsed
    );

  const finalResult =
    finalizeScreening(
      facts,
      ai
    );

  const now =
    Date.now();

  await applicationRef.update({
    aiScreening: {
      ...finalResult,

      screenedAt:
        now,

      model:
        process.env.GROQ_MODEL ||
        'configured-ai-model',

      version:
        'seller-screen-v2',
    },

    aiStatus:
      finalResult.label,

    aiScore:
      finalResult.score,

    aiAutoEligible:
      finalResult.autoEligible,

    aiLastScreenedAt:
      now,

    updatedAt:
      now,
  });

  return {
    applicationId,

    screening:
      finalResult,
  };
}

export async function POST(
  request: Request
) {
  try {
    await requireAdmin(
      request
    );

    const body =
      await request.json();

    /*
     * Single screening
     */
    if (
      body.applicationId
    ) {
      const result =
        await screenOne(
          text(
            body.applicationId
          )
        );

      return NextResponse.json({
        success: true,
        ...result,
      });
    }

    /*
     * Automatic screening of ALL applications.
     *
     * We only re-screen pending applications that:
     * - have never been screened
     * - or were screened using an older screening version
     */
    if (
      body.screenAll === true
    ) {
      const snapshot =
        await adminDb
          .ref(
            'sellerApplications'
          )
          .get();

      if (
        !snapshot.exists()
      ) {
        return NextResponse.json({
          success: true,
          screened: 0,
          results: [],
        });
      }

      const applications =
        snapshot.val() as Record<
          string,
          Record<string, unknown>
        >;

      const results: Array<{
        applicationId: string;
        screening?: ScreeningResult;
        skipped?: boolean;
        error?: string;
      }> = [];

      for (
        const [
          id,
          application,
        ] of Object.entries(
          applications
        )
      ) {
        const status =
          firstText(
            application,
            [
              'status',
            ]
          ).toLowerCase();

        const currentVersion =
          text(
            (
              application
                .aiScreening as
                | Record<
                    string,
                    unknown
                  >
                | undefined
            )?.version
          );

        /*
         * Do not automatically modify approved/rejected applications.
         */
        if (
          status ===
            'approved' ||
          status ===
            'rejected'
        ) {
          results.push({
            applicationId:
              id,
            skipped:
              true,
          });

          continue;
        }

        /*
         * Only screen missing/old results.
         */
        if (
          currentVersion ===
          'seller-screen-v2'
        ) {
          results.push({
            applicationId:
              id,
            skipped:
              true,
          });

          continue;
        }

        try {
          const result =
            await screenOne(
              id
            );

          results.push(
            result
          );
        } catch (error) {
          results.push({
            applicationId:
              id,

            error:
              error instanceof Error
                ? error.message
                : 'Screening failed.',
          });
        }
      }

      return NextResponse.json({
        success: true,

        screened:
          results.filter(
            (item) =>
              !item.skipped &&
              !item.error
          ).length,

        results,
      });
    }

    return NextResponse.json(
      {
        error:
          'Provide applicationId or screenAll=true.',
      },
      {
        status: 400,
      }
    );
  } catch (error) {
    console.error(
      'Seller AI screening failed:',
      error
    );

    return NextResponse.json(
      {
        error:
          error instanceof Error
            ? error.message
            : 'Seller AI screening failed.',
      },
      {
        status: 500,
      }
    );
  }
}
