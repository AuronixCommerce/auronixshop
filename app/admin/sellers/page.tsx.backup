'use client';

import {
  useEffect,
  useMemo,
  useState,
} from 'react';

import {
  onValue,
  ref,
} from 'firebase/database';

import {
  Search,
  Loader2,
  Sparkles,
  CheckCircle2,
  XCircle,
  Trash2,
  Clock,
  Mail,
  Phone,
  Globe,
  Building2,
  User,
  MapPin,
  AlertTriangle,
  ShieldAlert,
  Bot,
  RefreshCw,
} from 'lucide-react';

import {
  db,
  auth,
} from '@/lib/firebase';

import { AdminLayout } from '@/components/admin/admin-layout';

import {
  SellerAIScreeningCard,
} from '@/components/admin/seller-ai-screening-card';

type SellerApplication = {
  id: string;

  fullName?: string;
  name?: string;

  email?: string;

  phone?: string;

  companyName?: string;
  company?: string;

  website?: string;

  businessType?: string;

  address?: string;

  city?: string;
  state?: string;
  country?: string;
  zipCode?: string;

  products?: string;
  productCategories?: string;

  description?: string;
  businessDescription?: string;

  message?: string;

  catalogUrl?: string;

  status?: string;

  createdAt?: number | string;
  updatedAt?: number | string;

  aiStatus?: string;
  aiScore?: number;
  aiAutoEligible?: boolean;

  aiScreening?: {
    label?: string;
    score?: number;
    summary?: string;

    reasons?: string[];
    positiveSignals?: string[];
    riskSignals?: string[];
    missingInformation?: string[];
    contradictions?: string[];

    recommendation?:
      | 'AUTO_ONBOARD'
      | 'MANUAL_REVIEW'
      | 'DO_NOT_AUTO_APPROVE';

    autoEligible?: boolean;

    screenedAt?: number;
  };

  [key: string]: unknown;
};

type FilterType =
  | 'all'
  | 'pending'
  | 'approved'
  | 'rejected';

function clean(
  value: unknown
): string {
  return typeof value === 'string'
    ? value.trim()
    : '';
}

function formatDate(
  value: unknown
): string {
  if (!value) {
    return 'Unknown date';
  }

  const date =
    new Date(
      typeof value === 'number'
        ? value
        : String(value)
    );

  if (
    Number.isNaN(
      date.getTime()
    )
  ) {
    return 'Unknown date';
  }

  return date.toLocaleString();
}

function displayName(
  application: SellerApplication
): string {
  return (
    clean(
      application.fullName
    ) ||
    clean(
      application.name
    ) ||
    'Unnamed applicant'
  );
}

function statusOf(
  application: SellerApplication
): string {
  return (
    clean(
      application.status
    ).toLowerCase() ||
    'pending'
  );
}

export default function AdminSellersPage() {
  const [applications, setApplications] =
    useState<SellerApplication[]>(
      []
    );

  const [loading, setLoading] =
    useState(true);

  const [search, setSearch] =
    useState('');

  const [filter, setFilter] =
    useState<FilterType>('all');

  const [selectedId, setSelectedId] =
    useState<string | null>(
      null
    );

  const [actionLoading, setActionLoading] =
    useState(false);

  const [screeningLoading, setScreeningLoading] =
    useState(false);

  useEffect(() => {
    if (!db) {
      setLoading(false);
      return;
    }

    return onValue(
      ref(
        db,
        'sellerApplications'
      ),
      (snapshot) => {
        const value =
          snapshot.exists()
            ? snapshot.val()
            : {};

        const list: SellerApplication[] =
          Object.entries(
            value || {}
          ).map(
            ([id, item]) => ({
              id,
              ...(item as Record<
                string,
                unknown
              >),
            })
          );

        list.sort(
          (a, b) =>
            Number(
              b.updatedAt ||
                b.createdAt ||
                0
            ) -
            Number(
              a.updatedAt ||
                a.createdAt ||
                0
            )
        );

        setApplications(list);

        setLoading(false);

        /*
         * Keep the current selection if
         * it still exists.
         */
        if (
          selectedId &&
          !list.some(
            (item) =>
              item.id ===
              selectedId
          )
        ) {
          setSelectedId(null);
        }
      },
      (error) => {
        console.error(
          'Failed to load seller applications:',
          error
        );

        setLoading(false);
      }
    );
  }, [selectedId]);

  const filtered =
    useMemo(() => {
      const query =
        search
          .trim()
          .toLowerCase();

      return applications.filter(
        (application) => {
          const status =
            statusOf(
              application
            );

          const matchesFilter =
            filter === 'all' ||
            status === filter;

          const searchable = [
            displayName(
              application
            ),

            clean(
              application.email
            ),

            clean(
              application.phone
            ),

            clean(
              application.companyName
            ),

            clean(
              application.company
            ),

            clean(
              application.website
            ),

            clean(
              application.description
            ),

            clean(
              application.message
            ),
          ]
            .join(' ')
            .toLowerCase();

          const matchesSearch =
            !query ||
            searchable.includes(
              query
            );

          return (
            matchesFilter &&
            matchesSearch
          );
        }
      );
    }, [
      applications,
      search,
      filter,
    ]);

  const selected =
    applications.find(
      (application) =>
        application.id ===
        selectedId
    ) || null;

  const approve =
    async (
      application: SellerApplication
    ) => {
      if (
        !auth.currentUser ||
        actionLoading
      ) {
        return;
      }

      const name =
        displayName(
          application
        );

      if (
        !window.confirm(
          `Approve ${name} and create the seller account invitation?`
        )
      ) {
        return;
      }

      setActionLoading(true);

      try {
        const token =
          await auth.currentUser.getIdToken();

        const response =
          await fetch(
            '/api/admin/sellers/approve',
            {
              method: 'POST',

              headers: {
                'Content-Type':
                  'application/json',

                Authorization:
                  `Bearer ${token}`,
              },

              body:
                JSON.stringify({
                  applicationId:
                    application.id,
                }),
            }
          );

        const data =
          await response.json();

        if (!response.ok) {
          throw new Error(
            data.error ||
              'Unable to approve seller.'
          );
        }

        alert(
          'Seller approved and account invitation sent.'
        );
      } catch (error) {
        alert(
          error instanceof Error
            ? error.message
            : 'Unable to approve seller.'
        );
      } finally {
        setActionLoading(
          false
        );
      }
    };

  const reject =
    async (
      application: SellerApplication
    ) => {
      if (
        !auth.currentUser ||
        actionLoading
      ) {
        return;
      }

      const reason =
        window.prompt(
          'Enter the reason for rejecting this application:',
          'The application did not meet the current requirements.'
        );

      if (
        reason === null
      ) {
        return;
      }

      setActionLoading(true);

      try {
        const token =
          await auth.currentUser.getIdToken();

        const response =
          await fetch(
            '/api/admin/sellers/reject',
            {
              method: 'POST',

              headers: {
                'Content-Type':
                  'application/json',

                Authorization:
                  `Bearer ${token}`,
              },

              body:
                JSON.stringify({
                  applicationId:
                    application.id,

                  reason:
                    reason.trim(),
                }),
            }
          );

        const data =
          await response.json();

        if (!response.ok) {
          throw new Error(
            data.error ||
              'Unable to reject seller.'
          );
        }

        alert(
          'Seller application rejected.'
        );
      } catch (error) {
        alert(
          error instanceof Error
            ? error.message
            : 'Unable to reject seller.'
        );
      } finally {
        setActionLoading(
          false
        );
      }
    };

  const remove =
    async (
      application: SellerApplication
    ) => {
      if (
        !auth.currentUser ||
        actionLoading
      ) {
        return;
      }

      if (
        !window.confirm(
          `Permanently delete ${displayName(
            application
          )}'s application? This cannot be undone.`
        )
      ) {
        return;
      }

      setActionLoading(true);

      try {
        const token =
          await auth.currentUser.getIdToken();

        const response =
          await fetch(
            '/api/admin/sellers/delete',
            {
              method: 'POST',

              headers: {
                'Content-Type':
                  'application/json',

                Authorization:
                  `Bearer ${token}`,
              },

              body:
                JSON.stringify({
                  applicationId:
                    application.id,
                }),
            }
          );

        const data =
          await response.json();

        if (!response.ok) {
          throw new Error(
            data.error ||
              'Unable to delete application.'
          );
        }

        if (
          selectedId ===
          application.id
        ) {
          setSelectedId(
            null
          );
        }
      } catch (error) {
        alert(
          error instanceof Error
            ? error.message
            : 'Unable to delete application.'
        );
      } finally {
        setActionLoading(
          false
        );
      }
    };

  const runQuickScreen =
    async (
      application: SellerApplication
    ) => {
      setSelectedId(
        application.id
      );

      setScreeningLoading(
        true
      );

      try {
        const token =
          await auth.currentUser?.getIdToken();

        if (!token) {
          throw new Error(
            'Admin authentication is required.'
          );
        }

        const response =
          await fetch(
            '/api/admin/sellers/ai-screen',
            {
              method: 'POST',

              headers: {
                'Content-Type':
                  'application/json',

                Authorization:
                  `Bearer ${token}`,
              },

              body:
                JSON.stringify({
                  applicationId:
                    application.id,
                }),
            }
          );

        const data =
          await response.json();

        if (!response.ok) {
          throw new Error(
            data.error ||
              'AI screening failed.'
          );
        }
      } catch (error) {
        alert(
          error instanceof Error
            ? error.message
            : 'AI screening failed.'
        );
      } finally {
        setScreeningLoading(
          false
        );
      }
    };

  const counts = {
    all:
      applications.length,

    pending:
      applications.filter(
        (item) =>
          statusOf(item) ===
          'pending'
      ).length,

    approved:
      applications.filter(
        (item) =>
          statusOf(item) ===
          'approved'
      ).length,

    rejected:
      applications.filter(
        (item) =>
          statusOf(item) ===
          'rejected'
      ).length,
  };

  return (
    <AdminLayout>
      <div className="space-y-6">
        {/* HEADER */}
        <div className="flex flex-col gap-5 xl:flex-row xl:items-end xl:justify-between">
          <div>
            <div className="mb-3 text-xs font-semibold uppercase tracking-[0.12em] text-accent">
              AURONIX ADMIN
            </div>

            <h1 className="text-3xl font-semibold tracking-tight">
              Seller Applications
            </h1>

            <p className="mt-2 text-sm text-foreground-muted">
              Review applicants, run AI screening, approve genuine
              sellers, reject suspicious applications, or delete old records.
            </p>
          </div>

          <div className="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-2 text-xs text-foreground-muted">
            <Bot className="h-4 w-4" />
            AI screening available
          </div>
        </div>

        {/* STATS */}
        <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <MiniStat
            label="All Applications"
            value={counts.all}
          />

          <MiniStat
            label="Pending"
            value={counts.pending}
          />

          <MiniStat
            label="Approved"
            value={counts.approved}
          />

          <MiniStat
            label="Rejected"
            value={counts.rejected}
          />
        </div>

        {/* SEARCH / FILTER */}
        <div className="grid gap-3 lg:grid-cols-[1fr_180px]">
          <div className="relative">
            <Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-foreground-muted" />

            <input
              value={search}
              onChange={(event) =>
                setSearch(
                  event.target.value
                )
              }
              placeholder="Search sellers, company, email, website..."
              className="h-11 w-full rounded-xl border border-border bg-card pl-10 pr-4 text-sm outline-none focus:ring-2 focus:ring-accent/20"
            />
          </div>

          <select
            value={filter}
            onChange={(event) =>
              setFilter(
                event.target.value as FilterType
              )
            }
            className="h-11 rounded-xl border border-border bg-card px-3 text-sm outline-none"
          >
            <option value="all">
              All Applications
            </option>

            <option value="pending">
              Pending
            </option>

            <option value="approved">
              Approved
            </option>

            <option value="rejected">
              Rejected
            </option>
          </select>
        </div>

        {/* MAIN */}
        <div className="grid gap-5 xl:grid-cols-[380px_1fr]">
          {/* LIST */}
          <div className="overflow-hidden rounded-2xl border border-border bg-card">
            {loading ? (
              <div className="flex min-h-[400px] items-center justify-center">
                <Loader2 className="h-6 w-6 animate-spin" />
              </div>
            ) : filtered.length === 0 ? (
              <div className="p-10 text-center">
                <UsersEmpty />
              </div>
            ) : (
              <div className="max-h-[760px] divide-y divide-border overflow-y-auto">
                {filtered.map(
                  (
                    application
                  ) => {
                    const status =
                      statusOf(
                        application
                      );

                    const aiLabel =
                      clean(
                        application.aiStatus
                      );

                    const aiScore =
                      Number(
                        application.aiScore ||
                          application
                            .aiScreening
                            ?.score ||
                          0
                      );

                    return (
                      <button
                        key={
                          application.id
                        }
                        type="button"
                        onClick={() =>
                          setSelectedId(
                            application.id
                          )
                        }
                        className={`w-full p-4 text-left transition-colors hover:bg-secondary/40 ${
                          selectedId ===
                          application.id
                            ? 'bg-secondary'
                            : ''
                        }`}
                      >
                        <div className="flex items-start justify-between gap-3">
                          <div className="min-w-0">
                            <div className="truncate font-medium">
                              {displayName(
                                application
                              )}
                            </div>

                            <div className="mt-1 truncate text-xs text-foreground-muted">
                              {clean(
                                application.email
                              ) ||
                                'No email'}
                            </div>
                          </div>

                          <StatusBadge
                            status={
                              status
                            }
                          />
                        </div>

                        <div className="mt-3 flex flex-wrap gap-2">
                          {application.companyName ||
                          application.company ? (
                            <span className="inline-flex items-center gap-1 text-[11px] text-foreground-muted">
                              <Building2 className="h-3 w-3" />

                              {clean(
                                application.companyName ||
                                  application.company
                              )}
                            </span>
                          ) : null}

                          {aiLabel ? (
                            <AIStatusBadge
                              label={
                                aiLabel
                              }
                              score={
                                aiScore
                              }
                            />
                          ) : null}
                        </div>
                      </button>
                    );
                  }
                )}
              </div>
            )}
          </div>

          {/* DETAIL */}
          <div>
            {!selected ? (
              <div className="flex min-h-[500px] items-center justify-center rounded-2xl border border-dashed border-border bg-card p-10 text-center">
                <div>
                  <User className="mx-auto h-8 w-8 text-foreground-muted" />

                  <h2 className="mt-4 font-semibold">
                    Select an application
                  </h2>

                  <p className="mt-2 max-w-md text-sm leading-6 text-foreground-muted">
                    Choose a seller application from the list to
                    inspect the submitted information and run AI
                    screening.
                  </p>
                </div>
              </div>
            ) : (
              <div className="space-y-5">
                {/* APPLICATION HEADER */}
                <div className="rounded-2xl border border-border bg-card p-6">
                  <div className="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
                    <div>
                      <div className="flex flex-wrap items-center gap-2">
                        <StatusBadge
                          status={
                            statusOf(
                              selected
                            )
                          }
                        />

                        {selected.aiStatus ? (
                          <AIStatusBadge
                            label={
                              selected.aiStatus
                            }
                            score={Number(
                              selected.aiScore ||
                                selected
                                  .aiScreening
                                  ?.score ||
                                0
                            )}
                          />
                        ) : null}
                      </div>

                      <h2 className="mt-4 text-2xl font-semibold tracking-tight">
                        {displayName(
                          selected
                        )}
                      </h2>

                      <p className="mt-1 text-sm text-foreground-muted">
                        Submitted{' '}
                        {formatDate(
                          selected.createdAt
                        )}
                      </p>
                    </div>

                    <button
                      type="button"
                      onClick={() =>
                        runQuickScreen(
                          selected
                        )
                      }
                      disabled={
                        screeningLoading
                      }
                      className="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground disabled:opacity-50"
                    >
                      {screeningLoading ? (
                        <Loader2 className="h-4 w-4 animate-spin" />
                      ) : (
                        <Sparkles className="h-4 w-4" />
                      )}

                      {selected.aiScreening
                        ? 'Re-run AI'
                        : 'AI Screen'}
                    </button>
                  </div>

                  {/* ACTIONS */}
                  <div className="mt-6 flex flex-wrap gap-3 border-t border-border pt-5">
                    <button
                      type="button"
                      onClick={() =>
                        approve(
                          selected
                        )
                      }
                      disabled={
                        actionLoading ||
                        statusOf(
                          selected
                        ) ===
                          'approved'
                      }
                      className="inline-flex items-center gap-2 rounded-xl bg-green-600 px-4 py-2.5 text-sm font-medium text-white disabled:opacity-50"
                    >
                      <CheckCircle2 className="h-4 w-4" />
                      Approve & Create Account
                    </button>

                    <button
                      type="button"
                      onClick={() =>
                        reject(
                          selected
                        )
                      }
                      disabled={
                        actionLoading ||
                        statusOf(
                          selected
                        ) ===
                          'rejected'
                      }
                      className="inline-flex items-center gap-2 rounded-xl border border-orange-500/20 px-4 py-2.5 text-sm font-medium text-orange-700 disabled:opacity-50"
                    >
                      <XCircle className="h-4 w-4" />
                      Reject
                    </button>

                    <button
                      type="button"
                      onClick={() =>
                        remove(
                          selected
                        )
                      }
                      disabled={
                        actionLoading
                      }
                      className="inline-flex items-center gap-2 rounded-xl border border-red-500/20 px-4 py-2.5 text-sm font-medium text-red-700 disabled:opacity-50"
                    >
                      <Trash2 className="h-4 w-4" />
                      Delete
                    </button>
                  </div>
                </div>

                {/* AI SCREENING */}
                <SellerAIScreeningCard
                  applicationId={
                    selected.id
                  }
                  initialScreening={
                    selected.aiScreening
                      ? {
                          label:
                            selected
                              .aiScreening
                              ?.label as
                              | 'AI_APPROVED'
                              | 'LOOKS_GOOD'
                              | 'NEEDS_REVIEW'
                              | 'LOOKS_BUG'
                              | 'LOOKS_SPAM'
                              | 'HIGH_RISK',

                          score:
                            Number(
                              selected
                                .aiScreening
                                ?.score ||
                                0
                            ),

                          summary:
                            clean(
                              selected
                                .aiScreening
                                ?.summary
                            ),

                          reasons:
                            selected
                              .aiScreening
                              ?.reasons ||
                            [],

                          positiveSignals:
                            selected
                              .aiScreening
                              ?.positiveSignals ||
                            [],

                          riskSignals:
                            selected
                              .aiScreening
                              ?.riskSignals ||
                            [],

                          missingInformation:
                            selected
                              .aiScreening
                              ?.missingInformation ||
                            [],

                          contradictions:
                            selected
                              .aiScreening
                              ?.contradictions ||
                            [],

                          recommendation:
                            selected
                              .aiScreening
                              ?.recommendation,

                          autoEligible:
                            selected
                              .aiScreening
                              ?.autoEligible ===
                            true,

                          screenedAt:
                            selected
                              .aiScreening
                              ?.screenedAt,
                        }
                      : undefined
                  }
                />

                {/* CONTACT */}
                <Section title="Contact Information">
                  <InfoRow
                    icon={
                      <User className="h-4 w-4" />
                    }
                    label="Full Name"
                    value={
                      displayName(
                        selected
                      )
                    }
                  />

                  <InfoRow
                    icon={
                      <Mail className="h-4 w-4" />
                    }
                    label="Email"
                    value={
                      clean(
                        selected.email
                      ) ||
                      'Not provided'
                    }
                  />

                  <InfoRow
                    icon={
                      <Phone className="h-4 w-4" />
                    }
                    label="Phone"
                    value={
                      clean(
                        selected.phone
                      ) ||
                      'Not provided'
                    }
                  />

                  <InfoRow
                    icon={
                      <Globe className="h-4 w-4" />
                    }
                    label="Website"
                    value={
                      clean(
                        selected.website
                      ) ||
                      'Not provided'
                    }
                  />
                </Section>

                {/* BUSINESS */}
                <Section title="Business Information">
                  <InfoRow
                    icon={
                      <Building2 className="h-4 w-4" />
                    }
                    label="Company"
                    value={
                      clean(
                        selected.companyName ||
                          selected.company
                      ) ||
                      'Not provided'
                    }
                  />

                  <InfoRow
                    icon={
                      <Building2 className="h-4 w-4" />
                    }
                    label="Business Type"
                    value={
                      clean(
                        selected.businessType
                      ) ||
                      'Not provided'
                    }
                  />

                  <InfoRow
                    icon={
                      <MapPin className="h-4 w-4" />
                    }
                    label="Address"
                    value={
                      [
                        selected.address,
                        selected.city,
                        selected.state,
                        selected.zipCode,
                        selected.country,
                      ]
                        .map(clean)
                        .filter(Boolean)
                        .join(
                          ', '
                        ) ||
                      'Not provided'
                    }
                  />
                </Section>

                {/* PRODUCTS */}
                <Section title="Products & Marketplace Information">
                  <InfoRow
                    icon={
                      <Sparkles className="h-4 w-4" />
                    }
                    label="Categories"
                    value={
                      clean(
                        selected.productCategories
                      ) ||
                      clean(
                        selected.products
                      ) ||
                      'Not provided'
                    }
                  />

                  <InfoBlock
                    label="Business Description"
                    value={
                      clean(
                        selected.businessDescription
                      ) ||
                      clean(
                        selected.description
                      ) ||
                      'Not provided'
                    }
                  />

                  <InfoBlock
                    label="Message"
                    value={
                      clean(
                        selected.message
                      ) ||
                      'Not provided'
                    }
                  />

                  {clean(
                    selected.catalogUrl
                  ) && (
                    <InfoRow
                      icon={
                        <Globe className="h-4 w-4" />
                      }
                      label="Catalog"
                      value={
                        clean(
                          selected.catalogUrl
                        )
                      }
                    />
                  )}
                </Section>

                {/* AI SUMMARY */}
                <div className="rounded-2xl border border-border bg-secondary/30 p-5">
                  <div className="flex items-start gap-3">
                    {selected.aiAutoEligible ? (
                      <CheckCircle2 className="mt-0.5 h-5 w-5 shrink-0 text-green-600" />
                    ) : selected.aiStatus ===
                      'LOOKS_SPAM' ||
                      selected.aiStatus ===
                        'HIGH_RISK' ? (
                      <ShieldAlert className="mt-0.5 h-5 w-5 shrink-0 text-red-600" />
                    ) : (
                      <AlertTriangle className="mt-0.5 h-5 w-5 shrink-0 text-yellow-600" />
                    )}

                    <div>
                      <h3 className="font-semibold">
                        AI Decision Guidance
                      </h3>

                      <p className="mt-1 text-sm leading-6 text-foreground-muted">
                        {selected.aiAutoEligible
                          ? 'This application has passed the configured high-confidence AI screening criteria and may be eligible for automatic onboarding.'
                          : selected.aiStatus ===
                              'LOOKS_SPAM'
                            ? 'AI detected significant spam-like signals. Keep this application out of automatic onboarding and review it manually before any action.'
                            : selected.aiStatus ===
                                'HIGH_RISK'
                              ? 'AI detected elevated risk signals. Manual review is strongly recommended.'
                              : 'Use the AI assessment as decision support and review the application details before approval.'}
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>

        {/* FOOTNOTE */}
        <div className="rounded-2xl border border-border bg-card p-5 text-xs leading-5 text-foreground-muted">
          AI screening is an internal application-quality and risk
          assessment. It does not independently prove legal identity,
          ownership, licensing, or business authenticity. Final approval
          remains subject to your configured seller-review process.
        </div>
      </div>
    </AdminLayout>
  );
}

function MiniStat({
  label,
  value,
}: {
  label: string;
  value: number;
}) {
  return (
    <div className="rounded-2xl border border-border bg-card p-5">
      <div className="text-2xl font-semibold">
        {value}
      </div>

      <div className="mt-1 text-sm text-foreground-muted">
        {label}
      </div>
    </div>
  );
}

function StatusBadge({
  status,
}: {
  status: string;
}) {
  const normalized =
    status.toLowerCase();

  let className =
    'bg-secondary text-foreground-muted';

  if (
    normalized ===
    'approved'
  ) {
    className =
      'bg-green-500/10 text-green-700';
  }

  if (
    normalized ===
    'rejected'
  ) {
    className =
      'bg-red-500/10 text-red-700';
  }

  if (
    normalized ===
    'pending'
  ) {
    className =
      'bg-yellow-500/10 text-yellow-700';
  }

  return (
    <span
      className={`rounded-full px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide ${className}`}
    >
      {status}
    </span>
  );
}

function AIStatusBadge({
  label,
  score,
}: {
  label: string;
  score: number;
}) {
  const normalized =
    label.toUpperCase();

  let className =
    'bg-secondary text-foreground-muted';

  if (
    normalized ===
      'AI_APPROVED' ||
    normalized ===
      'LOOKS_GOOD'
  ) {
    className =
      'bg-green-500/10 text-green-700';
  }

  if (
    normalized ===
    'NEEDS_REVIEW'
  ) {
    className =
      'bg-yellow-500/10 text-yellow-700';
  }

  if (
    normalized ===
      'LOOKS_SPAM' ||
    normalized ===
      'HIGH_RISK'
  ) {
    className =
      'bg-red-500/10 text-red-700';
  }

  if (
    normalized ===
    'LOOKS_BUG'
  ) {
    className =
      'bg-orange-500/10 text-orange-700';
  }

  const readable =
    label
      .replaceAll(
        '_',
        ' '
      )
      .toLowerCase()
      .replace(
        /\b\w/g,
        (letter) =>
          letter.toUpperCase()
      );

  return (
    <span
      className={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[10px] font-semibold ${className}`}
    >
      <Bot className="h-3 w-3" />
      {readable}
      {score > 0
        ? ` ${score}%`
        : ''}
    </span>
  );
}

function Section({
  title,
  children,
}: {
  title: string;
  children: React.ReactNode;
}) {
  return (
    <div className="rounded-2xl border border-border bg-card overflow-hidden">
      <div className="border-b border-border px-5 py-4">
        <h3 className="text-sm font-semibold">
          {title}
        </h3>
      </div>

      <div className="divide-y divide-border">
        {children}
      </div>
    </div>
  );
}

function InfoRow({
  icon,
  label,
  value,
}: {
  icon: React.ReactNode;
  label: string;
  value: string;
}) {
  return (
    <div className="flex gap-4 px-5 py-4">
      <div className="mt-0.5 text-foreground-muted">
        {icon}
      </div>

      <div className="min-w-0 flex-1">
        <div className="text-xs uppercase tracking-wide text-foreground-muted">
          {label}
        </div>

        <div className="mt-1 break-words text-sm">
          {value}
        </div>
      </div>
    </div>
  );
}

function InfoBlock({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <div className="px-5 py-4">
      <div className="text-xs uppercase tracking-wide text-foreground-muted">
        {label}
      </div>

      <div className="mt-2 whitespace-pre-wrap text-sm leading-6">
        {value}
      </div>
    </div>
  );
}

function UsersEmpty() {
  return (
    <div>
      <User className="mx-auto h-8 w-8 text-foreground-muted" />

      <h2 className="mt-4 font-semibold">
        No seller applications
      </h2>

      <p className="mt-2 text-sm text-foreground-muted">
        No applications match the current search or filter.
      </p>
    </div>
  );
}
