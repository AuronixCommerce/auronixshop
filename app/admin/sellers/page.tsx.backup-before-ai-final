}

function getMessage(
  application: SellerApplication
): string {
  return firstText(application, [
    'message',
    'comments',
    'comment',
    'notes',
    'additionalInformation',
    'additionalInfo',
    'inquiry',
    'reason',
  ]);
}

function getProducts(
  application: SellerApplication
): string {
  return firstText(application, [
    'products',
    'productDescription',
    'productDetails',
    'productInfo',
  ]);
}

function getCategories(
  application: SellerApplication
): string {
  return firstText(application, [
    'productCategories',
    'categories',
    'category',
    'productCategory',
    'productsCategory',
  ]);
}

function getStatus(
  application: SellerApplication
): string {
  return (
    firstText(application, [
      'status',
    ]).toLowerCase() ||
    'pending'
  );
}

function getScore(
  application: SellerApplication
): number {
  const nested =
    Number(
      application.aiScreening
        ?.score
    );

  const direct =
    Number(
      application.aiScore
    );

  if (
    Number.isFinite(nested) &&
    nested > 0
  ) {
    return nested;
  }

  if (
    Number.isFinite(direct) &&
    direct > 0
  ) {
    return direct;
  }

  return 0;
}

function getAIStatus(
  application: SellerApplication
): string {
  return (
    text(
      application.aiStatus
    ) ||
    text(
      application.aiScreening
        ?.label
    )
  );
}

function formatDate(
  value: unknown
): string {
  if (!value) {
    return 'Unknown date';
  }

  const date =
    new Date(
      typeof value ===
        'number'
        ? value
        : String(value)
    );

  if (
    Number.isNaN(
      date.getTime()
    )
  ) {
    return 'Unknown date';
  }

  return date.toLocaleString();
}

function screeningLabel(
  application: SellerApplication
): ScreeningLabel | undefined {
  const value =
    getAIStatus(
      application
    );

  if (
    value ===
      'AI_APPROVED' ||
    value ===
      'LOOKS_GOOD' ||
    value ===
      'NEEDS_REVIEW' ||
    value ===
      'LOOKS_BUG' ||
    value ===
      'LOOKS_SPAM' ||
    value ===
      'HIGH_RISK'
  ) {
    return value;
  }

  return undefined;
}

function screeningClass(
  label?: string
): string {
  switch (label) {
    case 'AI_APPROVED':
    case 'LOOKS_GOOD':
      return 'bg-green-500/10 text-green-700 border-green-500/20';

    case 'NEEDS_REVIEW':
      return 'bg-yellow-500/10 text-yellow-700 border-yellow-500/20';

    case 'LOOKS_BUG':
      return 'bg-orange-500/10 text-orange-700 border-orange-500/20';

    case 'LOOKS_SPAM':
    case 'HIGH_RISK':
      return 'bg-red-500/10 text-red-700 border-red-500/20';

    default:
      return 'bg-secondary text-foreground-muted border-border';
  }
}

function screeningTitle(
  label?: string
): string {
  switch (label) {
    case 'AI_APPROVED':
      return 'AI Approved';

    case 'LOOKS_GOOD':
      return 'Looks Good';

    case 'NEEDS_REVIEW':
      return 'Needs Review';

    case 'LOOKS_BUG':
      return 'Looks Bug';

    case 'LOOKS_SPAM':
      return 'Looks Spam';

    case 'HIGH_RISK':
      return 'High Risk';

    default:
      return 'Not Screened';
  }
}

function normalizeAIForCard(
  application: SellerApplication
) {
  const nested =
    application.aiScreening;

  if (!nested) {
    return undefined;
  }

  const label =
    text(
      nested.label
    );

  if (
    label !==
      'AI_APPROVED' &&
    label !==
      'LOOKS_GOOD' &&
    label !==
      'NEEDS_REVIEW' &&
    label !==
      'LOOKS_BUG' &&
    label !==
      'LOOKS_SPAM' &&
    label !==
      'HIGH_RISK'
  ) {
    return undefined;
  }

  return {
    label,

    score:
      Number(
        nested.score ||
          application.aiScore ||
          0
      ),

    summary:
      text(
        nested.summary
      ),

    reasons:
      firstList(
        nested.reasons
      ),

    positiveSignals:
      firstList(
        nested.positiveSignals
      ),

    riskSignals:
      firstList(
        nested.riskSignals
      ),

    missingInformation:
      firstList(
        nested.missingInformation
      ),

    contradictions:
      firstList(
        nested.contradictions
      ),

    recommendation:
      nested.recommendation ===
        'AUTO_ONBOARD' ||
      nested.recommendation ===
        'MANUAL_REVIEW' ||
      nested.recommendation ===
        'DO_NOT_AUTO_APPROVE'
        ? nested.recommendation
        : undefined,

    autoEligible:
      nested.autoEligible ===
      true,

    screenedAt:
      Number(
        nested.screenedAt
      ) || undefined,
  };
}

export default function AdminSellersPage() {
  const [
    applications,
    setApplications,
  ] =
    useState<
      SellerApplication[]
    >([]);

  const [
    loading,
    setLoading,
  ] =
    useState(true);

  const [
    search,
    setSearch,
  ] =
    useState('');

  const [
    filter,
    setFilter,
  ] =
    useState<FilterType>(
      'all'
    );

  const [
    selectedId,
    setSelectedId,
  ] =
    useState<
      string | null
    >(null);

  const [
    actionLoading,
    setActionLoading,
  ] =
    useState(false);

  const [
    autoScreening,
    setAutoScreening,
  ] =
    useState(false);

  const [
    refreshNumber,
    setRefreshNumber,
  ] =
    useState(0);

  useEffect(() => {
    if (!db) {
      setLoading(false);
      return;
    }

    const unsubscribe =
      onValue(
        ref(
          db,
          'sellerApplications'
        ),
        (snapshot) => {
          const value =
            snapshot.exists()
              ? snapshot.val()
              : {};

          const list =
            Object.entries(
              value || {}
            ).map(
              ([id, item]) => ({
                id,

                ...(item as Record<
                  string,
                  unknown
                >),
              })
            ) as SellerApplication[];

          list.sort(
            (a, b) =>
              Number(
                b.updatedAt ||
                  b.createdAt ||
                  0
              ) -
              Number(
                a.updatedAt ||
                  a.createdAt ||
                  0
              )
          );

          setApplications(
            list
          );

          setLoading(false);
        },
        (error) => {
          console.error(
            'Unable to load seller applications:',
            error
          );

          setLoading(false);
        }
      );

    return () => {
      unsubscribe();
    };
  }, [refreshNumber]);

  /*
   * Automatically screen pending/unprocessed applications.
   *
   * This happens when the admin seller page opens.
   * The API itself decides which applications actually need
   * screening and never modifies approved/rejected applications.
   */
  useEffect(() => {
    let cancelled = false;

    async function automaticallyScreen() {
      if (
        !auth.currentUser ||
        cancelled ||
        applications.length === 0
      ) {
        return;
      }

      /*
       * Do not repeatedly run while the list is being updated.
       */
      if (autoScreening) {
        return;
      }

      const needsScreening =
        applications.some(
          (application) => {
            const status =
              getStatus(
                application
              );

            const version =
              text(
                application
                  .aiScreening
                  ?.version
              );

            return (
              status !==
                'approved' &&
              status !==
                'rejected' &&
              version !==
                'seller-screen-v2'
            );
          }
        );

      if (!needsScreening) {
        return;
      }

      setAutoScreening(
        true
      );

      try {
        const token =
          await auth.currentUser.getIdToken();

        await fetch(
          '/api/admin/sellers/ai-screen',
          {
            method: 'POST',

            headers: {
              'Content-Type':
                'application/json',

              Authorization:
                `Bearer ${token}`,
            },

            body: JSON.stringify({
              screenAll:
                true,
            }),
          }
        );
      } catch (error) {
        console.error(
          'Automatic seller AI screening failed:',
          error
        );
      } finally {
        if (!cancelled) {
          setAutoScreening(
            false
          );

          /*
           * Firebase listener should update automatically.
           * This refresh is simply a fallback for slow listeners.
           */
          window.setTimeout(
            () => {
              if (!cancelled) {
                setRefreshNumber(
                  (value) =>
                    value + 1
                );
              }
            },
            500
          );
        }
      }
    }

    automaticallyScreen();

    return () => {
      cancelled = true;
    };
  }, [
    applications,
  ]);

  const selected =
    applications.find(
      (item) =>
        item.id ===
        selectedId
    ) || null;

  const filtered =
    useMemo(() => {
      const query =
        search
          .trim()
          .toLowerCase();

      return applications.filter(
        (application) => {
          const status =
            getStatus(
              application
            );

          const matchesFilter =
            filter === 'all' ||
            status === filter;

          const searchable = [
            getName(
              application
            ),
            getEmail(
              application
            ),
            getCompany(
              application
            ),
            getWebsite(
              application
            ),
            getBusinessDescription(
              application
            ),
            getMessage(
              application
            ),
            getProducts(
              application
            ),
            getCategories(
              application
            ),
          ]
            .join(' ')
            .toLowerCase();

          const matchesSearch =
            !query ||
            searchable.includes(
              query
            );

          return (
            matchesFilter &&
            matchesSearch
          );
        }
      );
    }, [
      applications,
      filter,
      search,
    ]);

  const approve =
    async () => {
      if (
        !selected ||
        !auth.currentUser ||
        actionLoading
      ) {
        return;
      }

      if (
        !window.confirm(
          `Approve ${getName(
            selected
          )} and create the seller account invitation?`
        )
      ) {
        return;
      }

      setActionLoading(
        true
      );

      try {
        const token =
          await auth.currentUser.getIdToken();

        const response =
          await fetch(
            '/api/admin/sellers/approve',
            {
              method: 'POST',

              headers: {
                'Content-Type':
                  'application/json',

                Authorization:
                  `Bearer ${token}`,
              },

              body:
                JSON.stringify({
                  applicationId:
                    selected.id,
                }),
            }
          );

        const data =
          await response.json();

        if (!response.ok) {
          throw new Error(
            data.error ||
              'Unable to approve seller.'
          );
        }

        alert(
          'Seller approved and account invitation sent.'
        );
      } catch (error) {
        alert(
          error instanceof Error
            ? error.message
            : 'Unable to approve seller.'
        );
      } finally {
        setActionLoading(
          false
        );
      }
    };

  const reject =
    async () => {
      if (
        !selected ||
        !auth.currentUser ||
        actionLoading
      ) {
        return;
      }

      const reason =
        window.prompt(
          'Reason for rejection:',
          'The application did not meet the current requirements.'
        );

      if (
        reason === null
      ) {
        return;
      }

      setActionLoading(
        true
      );

      try {
        const token =
          await auth.currentUser.getIdToken();

        const response =
          await fetch(
            '/api/admin/sellers/reject',
            {
              method: 'POST',

              headers: {
                'Content-Type':
                  'application/json',

                Authorization:
                  `Bearer ${token}`,
              },

              body:
                JSON.stringify({
                  applicationId:
                    selected.id,

                  reason:
                    reason.trim(),
                }),
            }
          );

        const data =
          await response.json();

        if (!response.ok) {
          throw new Error(
            data.error ||
              'Unable to reject seller.'
          );
        }

        alert(
          'Seller application rejected.'
        );
      } catch (error) {
        alert(
          error instanceof Error
            ? error.message
            : 'Unable to reject seller.'
        );
      } finally {
        setActionLoading(
          false
        );
      }
    };

  const remove =
    async () => {
      if (
        !selected ||
        !auth.currentUser ||
        actionLoading
      ) {
        return;
      }

      if (
        !window.confirm(
          `Permanently delete ${getName(
            selected
          )}'s seller application? This cannot be undone.`
        )
      ) {
        return;
      }

      setActionLoading(
        true
      );

      try {
        const token =
          await auth.currentUser.getIdToken();

        const response =
          await fetch(
            '/api/admin/sellers/delete',
            {
              method: 'POST',

              headers: {
                'Content-Type':
                  'application/json',

                Authorization:
                  `Bearer ${token}`,
              },

              body:
                JSON.stringify({
                  applicationId:
                    selected.id,
                }),
            }
          );

        const data =
          await response.json();

        if (!response.ok) {
          throw new Error(
            data.error ||
              'Unable to delete seller application.'
          );
        }

        setSelectedId(
          null
        );
      } catch (error) {
        alert(
          error instanceof Error
            ? error.message
            : 'Unable to delete application.'
        );
      } finally {
        setActionLoading(
          false
        );
      }
    };

  const runManualScreen =
    async (
      applicationId: string
    ) => {
      if (
        !auth.currentUser ||
        actionLoading
      ) {
        return;
      }

      setActionLoading(
        true
      );

      try {
        const token =
          await auth.currentUser.getIdToken();

        const response =
          await fetch(
            '/api/admin/sellers/ai-screen',
            {
              method: 'POST',

              headers: {
                'Content-Type':
                  'application/json',

                Authorization:
                  `Bearer ${token}`,
              },

              body:
                JSON.stringify({
                  applicationId,
                }),
            }
          );

        const data =
          await response.json();

        if (!response.ok) {
          throw new Error(
            data.error ||
              'AI screening failed.'
          );
        }
      } catch (error) {
        alert(
          error instanceof Error
            ? error.message
            : 'AI screening failed.'
        );
      } finally {
        setActionLoading(
          false
        );
      }
    };

  const counts = {
    all:
      applications.length,

    pending:
      applications.filter(
        (item) =>
          getStatus(item) ===
          'pending'
      ).length,

    approved:
      applications.filter(
        (item) =>
          getStatus(item) ===
          'approved'
      ).length,

    rejected:
      applications.filter(
        (item) =>
          getStatus(item) ===
          'rejected'
      ).length,

    aiApproved:
      applications.filter(
        (item) =>
          getAIStatus(item) ===
          'AI_APPROVED'
      ).length,

    spam:
      applications.filter(
        (item) => {
          const label =
            getAIStatus(
              item
            );

          return (
            label ===
              'LOOKS_SPAM' ||
            label ===
              'HIGH_RISK'
          );
        }
      ).length,
  };

  const selectedBusinessDescription =
    selected
      ? getBusinessDescription(
          selected
        )
      : '';

  const selectedMessage =
    selected
      ? getMessage(
          selected
        )
      : '';

  const selectedAddress =
    selected
      ? [
          firstText(
            selected,
            [
              'address',
              'businessAddress',
              'streetAddress',
            ]
          ),

          firstText(
            selected,
            [
              'city',
              'businessCity',
            ]
          ),

          firstText(
            selected,
            [
              'state',
              'province',
              'businessState',
            ]
          ),

          firstText(
            selected,
            [
              'zipCode',
              'zip',
              'postalCode',
            ]
          ),

          firstText(
            selected,
            [
              'country',
              'businessCountry',
            ]
          ),
        ]
          .filter(Boolean)
          .join(', ')
      : '';

  return (
    <AdminLayout>
      <div className="space-y-6">
        {/* HEADER */}
        <div className="flex flex-col gap-5 xl:flex-row xl:items-end xl:justify-between">
          <div>
            <div className="mb-3 text-xs font-semibold uppercase tracking-[0.12em] text-accent">
              AURONIX ADMIN
            </div>

            <h1 className="text-3xl font-semibold tracking-tight">
              Seller Applications
            </h1>

            <p className="mt-2 max-w-3xl text-sm leading-6 text-foreground-muted">
              Review seller applications, inspect submitted business
              information, and use AI screening to identify strong,
              incomplete, or suspicious applications.
            </p>
          </div>

          <div className="flex flex-wrap gap-3">
            <div className="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-2 text-xs">
              {autoScreening ? (
                <>
                  <Loader2 className="h-3.5 w-3.5 animate-spin" />
                  AI screening applications...
                </>
              ) : (
                <>
                  <Bot className="h-3.5 w-3.5" />
                  AI screening ready
                </>
              )}
            </div>

            <button
              type="button"
              onClick={() =>
                setRefreshNumber(
                  (value) =>
                    value + 1
                )
              }
              className="inline-flex items-center gap-2 rounded-xl border border-border px-4 py-2.5 text-sm font-medium transition hover:bg-secondary"
            >
              <RefreshCw className="h-4 w-4" />
              Refresh
            </button>
          </div>
        </div>

        {/* STATS */}
        <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
          <MiniStat
            label="All"
            value={counts.all}
          />

          <MiniStat
            label="Pending"
            value={counts.pending}
          />

          <MiniStat
            label="Approved"
            value={counts.approved}
          />

          <MiniStat
            label="Rejected"
            value={counts.rejected}
          />

          <MiniStat
            label="AI Approved"
            value={counts.aiApproved}
            green
          />

          <MiniStat
            label="AI Risk/Spam"
            value={counts.spam}
            red
          />
        </div>

        {/* SEARCH + FILTER */}
        <div className="grid gap-3 lg:grid-cols-[1fr_190px]">
          <div className="relative">
            <Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-foreground-muted" />

            <input
              value={search}
              onChange={(event) =>
                setSearch(
                  event.target.value
                )
              }
              placeholder="Search applicant, company, email, website, description..."
              className="h-11 w-full rounded-xl border border-border bg-card pl-10 pr-4 text-sm outline-none focus:ring-2 focus:ring-accent/20"
            />
          </div>

          <select
            value={filter}
            onChange={(event) =>
              setFilter(
                event.target.value as FilterType
              )
            }
            className="h-11 rounded-xl border border-border bg-card px-3 text-sm outline-none"
          >
            <option value="all">
              All Applications
            </option>

            <option value="pending">
              Pending
            </option>

            <option value="approved">
              Approved
            </option>

            <option value="rejected">
              Rejected
            </option>
          </select>
        </div>

        {/* CONTENT */}
        <div className="grid gap-5 xl:grid-cols-[380px_1fr]">
          {/* LIST */}
          <div className="overflow-hidden rounded-2xl border border-border bg-card">
            {loading ? (
              <div className="flex min-h-[420px] items-center justify-center">
                <Loader2 className="h-6 w-6 animate-spin" />
              </div>
            ) : filtered.length === 0 ? (
              <div className="p-12 text-center">
                <User className="mx-auto h-8 w-8 text-foreground-muted" />

                <h2 className="mt-4 font-semibold">
                  No seller applications
                </h2>

                <p className="mt-2 text-sm leading-6 text-foreground-muted">
                  No applications match the current filter or search.
                </p>
              </div>
            ) : (
              <div className="max-h-[800px] divide-y divide-border overflow-y-auto">
                {filtered.map(
                  (
                    application
                  ) => {
                    const ai =
                      screeningLabel(
                        application
                      );

                    return (
                      <button
                        key={
                          application.id
                        }
                        type="button"
                        onClick={() =>
                          setSelectedId(
                            application.id
                          )
                        }
                        className={`w-full p-4 text-left transition-colors hover:bg-secondary/40 ${
                          selectedId ===
                          application.id
                            ? 'bg-secondary'
                            : ''
                        }`}
                      >
                        <div className="flex items-start justify-between gap-3">
                          <div className="min-w-0">
                            <div className="truncate font-medium">
                              {getName(
                                application
                              )}
                            </div>

                            <div className="mt-1 truncate text-xs text-foreground-muted">
                              {getEmail(
                                application
                              ) ||
                                'No email'}
                            </div>
                          </div>

                          <StatusBadge
                            status={getStatus(
                              application
                            )}
                          />
                        </div>

                        {getCompany(
                          application
                        ) && (
                          <div className="mt-3 flex items-center gap-1.5 truncate text-xs text-foreground-muted">
                            <Building2 className="h-3 w-3 shrink-0" />
                            {getCompany(
                              application
                            )}
                          </div>
                        )}

                        <div className="mt-3 flex flex-wrap gap-2">
                          {ai ? (
                            <span
                              className={`inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-semibold ${screeningClass(
                                ai
                              )}`}
                            >
                              <Bot className="h-3 w-3" />

                              {screeningTitle(
                                ai
                              )}

                              {getScore(
                                application
                              ) > 0
                                ? ` · ${getScore(
                                    application
                                  )}%`
                                : ''}
                            </span>
                          ) : (
                            <span className="inline-flex items-center gap-1.5 rounded-full border border-border bg-secondary px-2.5 py-1 text-[10px] font-semibold text-foreground-muted">
                              <Clock className="h-3 w-3" />
                              AI pending
                            </span>
                          )}

                          {application.aiAutoEligible ===
                          true ? (
                            <span className="rounded-full bg-green-600 px-2.5 py-1 text-[10px] font-semibold text-white">
                              AUTO ELIGIBLE
                            </span>
                          ) : null}
                        </div>
                      </button>
                    );
                  }
                )}
              </div>
            )}
          </div>

          {/* DETAIL */}
          <div>
            {!selected ? (
              <div className="flex min-h-[560px] items-center justify-center rounded-2xl border border-dashed border-border bg-card p-10 text-center">
                <div>
                  <Bot className="mx-auto h-9 w-9 text-foreground-muted" />

                  <h2 className="mt-4 font-semibold">
                    Select a seller application
                  </h2>

                  <p className="mx-auto mt-2 max-w-md text-sm leading-6 text-foreground-muted">
                    Review the complete submission and inspect
                    the AI screening result.
                  </p>
                </div>
              </div>
            ) : (
              <div className="space-y-5">
                {/* HEADER */}
                <div className="rounded-2xl border border-border bg-card p-6">
                  <div className="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
                    <div>
                      <div className="flex flex-wrap gap-2">
                        <StatusBadge
                          status={
                            getStatus(
                              selected
                            )
                          }
                        />

                        {getAIStatus(
                          selected
                        ) ? (
                          <span
                            className={`inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-semibold ${screeningClass(
                              getAIStatus(
                                selected
                              )
                            )}`}
                          >
                            <Bot className="h-3 w-3" />

                            {screeningTitle(
                              getAIStatus(
                                selected
                              )
                            )}

                            {getScore(
                              selected
                            ) > 0
                              ? ` · ${getScore(
                                  selected
                                )}%`
                              : ''}
                          </span>
                        ) : null}
                      </div>

                      <h2 className="mt-4 text-2xl font-semibold tracking-tight">
                        {getName(
                          selected
                        )}
                      </h2>

                      <p className="mt-1 text-sm text-foreground-muted">
                        Submitted{' '}
                        {formatDate(
                          selected.createdAt
                        )}
                      </p>
                    </div>

                    <button
                      type="button"
                      onClick={() =>
                        runManualScreen(
                          selected.id
                        )
                      }
                      disabled={
                        actionLoading
                      }
                      className="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground disabled:opacity-50"
                    >
                      {actionLoading ? (
                        <Loader2 className="h-4 w-4 animate-spin" />
                      ) : (
                        <Sparkles className="h-4 w-4" />
                      )}

                      {getAIStatus(
                        selected
                      )
                        ? 'Run AI Again'
                        : 'AI Screen'}
                    </button>
                  </div>

                  <div className="mt-6 flex flex-wrap gap-3 border-t border-border pt-5">
                    <button
                      type="button"
                      onClick={
                        approve
                      }
                      disabled={
                        actionLoading ||
                        getStatus(
                          selected
                        ) ===
                          'approved'
                      }
                      className="inline-flex items-center gap-2 rounded-xl bg-green-600 px-4 py-2.5 text-sm font-medium text-white disabled:opacity-50"
                    >
                      <CheckCircle2 className="h-4 w-4" />
                      Approve & Create Account
                    </button>

                    <button
                      type="button"
                      onClick={
                        reject
                      }
                      disabled={
                        actionLoading ||
                        getStatus(
                          selected
                        ) ===
                          'rejected'
                      }
                      className="inline-flex items-center gap-2 rounded-xl border border-orange-500/20 px-4 py-2.5 text-sm font-medium text-orange-700 disabled:opacity-50"
                    >
                      <XCircle className="h-4 w-4" />
                      Reject
                    </button>

                    <button
                      type="button"
                      onClick={
                        remove
                      }
                      disabled={
                        actionLoading
                      }
                      className="inline-flex items-center gap-2 rounded-xl border border-red-500/20 px-4 py-2.5 text-sm font-medium text-red-700 disabled:opacity-50"
                    >
                      <Trash2 className="h-4 w-4" />
                      Delete
                    </button>
                  </div>
                </div>

                {/* AI SCREENING */}
                <SellerAIScreeningCard
                  applicationId={
                    selected.id
                  }
                  initialScreening={
                    normalizeAIForCard(
                      selected
                    )
                  }
                />

                {/* CONTACT */}
                <InfoSection title="Contact Information">
                  <InfoRow
                    icon={
                      <User className="h-4 w-4" />
                    }
                    label="Full Name"
                    value={getName(
                      selected
                    )}
                  />

                  <InfoRow
                    icon={
                      <Mail className="h-4 w-4" />
                    }
                    label="Email"
                    value={
                      getEmail(
                        selected
                      ) ||
                      'Not provided'
                    }
                  />

                  <InfoRow
                    icon={
                      <Phone className="h-4 w-4" />
                    }
                    label="Phone"
                    value={
                      getPhone(
                        selected
                      ) ||
                      'Not provided'
                    }
                  />

                  <InfoRow
                    icon={
                      <Globe className="h-4 w-4" />
                    }
                    label="Website"
                    value={
                      getWebsite(
                        selected
                      ) ||
                      'Not provided'
                    }
                  />
                </InfoSection>

                {/* BUSINESS */}
                <InfoSection title="Business Information">
                  <InfoRow
                    icon={
                      <Building2 className="h-4 w-4" />
                    }
                    label="Company"
                    value={
                      getCompany(
                        selected
                      ) ||
                      'Not provided'
                    }
                  />

                  <InfoRow
                    icon={
                      <Building2 className="h-4 w-4" />
                    }
                    label="Business Type"
                    value={
                      firstText(
                        selected,
                        [
                          'businessType',
                          'companyType',
                          'entityType',
                        ]
                      ) ||
                      'Not provided'
                    }
                  />

                  <InfoRow
                    icon={
                      <MapPin className="h-4 w-4" />
                    }
                    label="Address"
                    value={
                      selectedAddress ||
                      'Not provided'
                    }
                  />
                </InfoSection>

                {/* PRODUCTS */}
                <InfoSection title="Products & Marketplace Information">
                  <InfoRow
                    icon={
                      <Sparkles className="h-4 w-4" />
                    }
                    label="Product Categories"
                    value={
                      getCategories(
                        selected
                      ) ||
                      'Not provided'
                    }
                  />

                  <InfoBlock
                    title="Products"
                    value={
                      getProducts(
                        selected
                      ) ||
                      'Not provided'
                    }
                  />

                  <InfoBlock
                    title="Business Description"
                    value={
                      selectedBusinessDescription ||
                      'No business description provided.'
                    }
                  />

                  <InfoBlock
                    title="Applicant Message"
                    value={
                      selectedMessage ||
                      'No applicant message provided.'
                    }
                  />

                  <InfoRow
                    icon={
                      <Globe className="h-4 w-4" />
                    }
                    label="Catalog"
                    value={
                      firstText(
                        selected,
                        [
                          'catalogUrl',
                          'catalog',
                          'catalogURL',
                          'catalogLink',
                          'catalogueUrl',
                          'catalogue',
                        ]
                      ) ||
                      'Not provided'
                    }
                  />
                </InfoSection>

                {/* AI GUIDANCE */}
                <div className="rounded-2xl border border-border bg-card p-5">
                  <div className="flex items-start gap-3">
                    {selected.aiAutoEligible ===
                    true ? (
                      <CheckCircle2 className="mt-0.5 h-5 w-5 shrink-0 text-green-600" />
                    ) : getAIStatus(
                        selected
                      ) ===
                        'LOOKS_SPAM' ||
                      getAIStatus(
                        selected
                      ) ===
                        'HIGH_RISK' ? (
                      <ShieldAlert className="mt-0.5 h-5 w-5 shrink-0 text-red-600" />
                    ) : (
                      <AlertTriangle className="mt-0.5 h-5 w-5 shrink-0 text-yellow-600" />
                    )}

                    <div>
                      <h3 className="font-semibold">
                        AI Decision Guidance
                      </h3>

                      <p className="mt-1 text-sm leading-6 text-foreground-muted">
                        {selected.aiAutoEligible ===
                        true
                          ? 'This application passed the configured high-confidence screening rules. It is marked AI Approved and Auto Eligible, but the account is not created until the approval action is executed.'
                          : getAIStatus(
                                selected
                              ) ===
                              'LOOKS_SPAM'
                            ? 'AI detected significant spam-like signals. Do not use automatic onboarding; manually review before taking action.'
                            : getAIStatus(
                                  selected
                                ) ===
                                'HIGH_RISK'
                              ? 'AI detected elevated risk indicators. Manual review is strongly recommended.'
                              : 'Use the AI assessment as decision support together with the complete submitted information.'}
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>

        <div className="rounded-2xl border border-border bg-card p-5 text-xs leading-5 text-foreground-muted">
          AI screening is an internal application-quality and risk
          assessment. It does not independently prove legal identity,
          ownership, licensing, or real-world business authenticity.
          Final seller approval remains controlled by the administrator.
        </div>
      </div>
    </AdminLayout>
  );
}

function MiniStat({
  label,
  value,
  green,
  red,
}: {
  label: string;
  value: number;
  green?: boolean;
  red?: boolean;
}) {
  return (
    <div
      className={`rounded-2xl border bg-card p-5 ${
        green
          ? 'border-green-500/20'
          : red
            ? 'border-red-500/20'
            : 'border-border'
      }`}
    >
      <div
        className={`text-2xl font-semibold ${
          green
            ? 'text-green-700'
            : red
              ? 'text-red-700'
              : ''
        }`}
      >
        {value}
      </div>

      <div className="mt-1 text-sm text-foreground-muted">
        {label}
      </div>
    </div>
  );
}

function StatusBadge({
  status,
}: {
  status: string;
}) {
  const normalized =
    status.toLowerCase();

  let className =
    'border-border bg-secondary text-foreground-muted';

  if (
    normalized ===
    'approved'
  ) {
    className =
      'border-green-500/20 bg-green-500/10 text-green-700';
  }

  if (
    normalized ===
    'rejected'
  ) {
    className =
      'border-red-500/20 bg-red-500/10 text-red-700';
  }

  if (
    normalized ===
    'pending'
  ) {
    className =
      'border-yellow-500/20 bg-yellow-500/10 text-yellow-700';
  }

  return (
    <span
      className={`rounded-full border px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide ${className}`}
    >
      {status}
    </span>
  );
}

function InfoSection({
  title,
  children,
}: {
  title: string;
  children: React.ReactNode;
}) {
  return (
    <section className="overflow-hidden rounded-2xl border border-border bg-card">
      <div className="border-b border-border px-5 py-4">
        <h3 className="text-sm font-semibold">
          {title}
        </h3>
      </div>

      <div className="divide-y divide-border">
        {children}
      </div>
    </section>
  );
}

function InfoRow({
  icon,
  label,
  value,
}: {
  icon: React.ReactNode;
  label: string;
  value: string;
}) {
  return (
    <div className="flex gap-4 px-5 py-4">
      <div className="mt-0.5 text-foreground-muted">
        {icon}
      </div>

      <div className="min-w-0 flex-1">
        <div className="text-xs uppercase tracking-wide text-foreground-muted">
          {label}
        </div>

        <div className="mt-1 break-words text-sm">
          {value}
        </div>
      </div>
    </div>
  );
}

function InfoBlock({
  title,
  value,
}: {
  title: string;
  value: string;
}) {
  return (
    <div className="px-5 py-5">
      <div className="text-xs font-medium uppercase tracking-wide text-foreground-muted">
        {title}
      </div>

      <div className="mt-3 whitespace-pre-wrap text-sm leading-7">
        {value}
      </div>
    </div>
  );
}
