type ScreeningLabel =
  | 'AI_APPROVED'
  | 'LOOKS_GOOD'
  | 'NEEDS_REVIEW'
  | 'LOOKS_BUG'
  | 'LOOKS_SPAM'
  | 'HIGH_RISK';

function text(
  value: unknown
): string {
  if (
    typeof value ===
      'string' ||
    typeof value ===
      'number'
  ) {
    return String(value).trim();
  }

  return '';
}

function firstText(
  application: SellerApplication,
  keys: string[]
): string {
  for (const key of keys) {
    const value =
      text(
        application[key]
      );

    if (value) {
      return value;
    }
  }

  return '';
}

function firstList(
  value: unknown
): string[] {
  if (!Array.isArray(value)) {
    return [];
  }

  return value
    .map(text)
    .filter(Boolean);
}

function getName(
  application: SellerApplication
): string {
  return (
    firstText(application, [
      'fullName',
      'name',
      'applicantName',
      'contactName',
    ]) ||
    'Unnamed applicant'
  );
}

function getEmail(
  application: SellerApplication
): string {
  return firstText(application, [
    'email',
    'contactEmail',
    'businessEmail',
  ]);
}

function getPhone(
  application: SellerApplication
): string {
  return firstText(application, [
    'phone',
    'phoneNumber',
    'mobile',
    'contactPhone',
  ]);
}

function getCompany(
  application: SellerApplication
): string {
  return firstText(application, [
    'companyName',
    'company',
    'businessName',
    'organization',
  ]);
}

function getWebsite(
  application: SellerApplication
): string {
  return firstText(application, [
    'website',
    'websiteUrl',
    'companyWebsite',
    'businessWebsite',
    'url',
  ]);
}

function getBusinessDescription(
  application: SellerApplication
): string {
  return firstText(application, [
    'businessDescription',
    'business_desc',
    'businessDesc',
    'description',
    'companyDescription',
    'aboutBusiness',
    'aboutCompany',
    'about',
